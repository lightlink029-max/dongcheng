<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_psc_project_form_sourcing_website" model="ir.ui.view">
        <field name="name">psc.publishing.project.form.sourcing.website</field>
        <field name="model">psc.publishing.project</field>
        <field name="inherit_id" ref="product_social_content_bridge.view_psc_project_form_market_operations"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="采购服务官网" name="sourcing_website">
                    <div class="alert alert-info" role="alert">
                        网站只负责获客和收集采购需求；产品、客户、报价、采购、库存和交付继续使用 Odoo 标准业务模块。
                    </div>
                    <group>
                        <group string="询盘归属">
                            <field name="website_id" options="{'no_create': True}"/>
                            <field name="website_inquiry_enabled"/>
                            <field name="website_service_email" widget="email"/>
                            <field name="website_whatsapp_url" widget="url"/>
                        </group>
                        <group string="公开内容">
                            <field name="website_public_name"/>
                            <field name="website_public_summary"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_psc_customer_requirement_list_sourcing" model="ir.ui.view">
        <field name="name">psc.customer.requirement.list.sourcing</field>
        <field name="model">psc.customer.requirement</field>
        <field name="inherit_id" ref="product_social_content_bridge.view_psc_customer_requirement_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='organization_type']" position="before">
                <field name="website_id" optional="show"/>
                <field name="request_type" optional="show"/>
                <field name="product_category" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="target_unit_price" optional="show"/>
                <field name="delivery_country_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_psc_customer_requirement_form_sourcing" model="ir.ui.view">
        <field name="name">psc.customer.requirement.form.sourcing</field>
        <field name="model">psc.customer.requirement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="stage" widget="statusbar" statusbar_visible="new,qualified,quoted,sample,negotiation,won"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="客户与来源">
                            <field name="lead_id"/>
                            <field name="website_id"/>
                            <field name="project_id"/>
                            <field name="track_id"/>
                            <field name="website_source_url" widget="url"/>
                            <field name="website_language"/>
                        </group>
                        <group string="采购概况">
                            <field name="request_type"/>
                            <field name="product_category"/>
                            <field name="business_stage"/>
                            <field name="product_ids" widget="many2many_tags"/>
                            <field name="organization_type"/>
                            <field name="contact_role"/>
                        </group>
                    </group>
                    <group>
                        <group string="数量与价格">
                            <field name="quantity"/>
                            <field name="target_unit_price"/>
                            <field name="budget"/>
                            <field name="currency_id"/>
                            <field name="sample_required"/>
                            <field name="target_purchase_date"/>
                        </group>
                        <group string="交付">
                            <field name="delivery_country_id"/>
                            <field name="delivery_port"/>
                            <field name="incoterm"/>
                            <field name="reference_url" widget="url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="详细需求">
                            <group><field name="requirement_details" nolabel="1" colspan="2"/></group>
                        </page>
                        <page string="定制、包装与合规">
                            <group>
                                <field name="customization_requirements"/>
                                <field name="packaging_requirements"/>
                                <field name="certification_requirements"/>
                            </group>
                        </page>
                        <page string="客户附件">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="未成交说明" invisible="stage != 'lost'">
                            <field name="lost_reason"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_template_form_sourcing" model="ir.ui.view">
        <field name="name">product.template.form.sourcing</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_ok']" position="after">
                <field name="sourcing_inquiry_only"/>
            </xpath>
        </field>
    </record>

    <record id="view_ll_sourcing_website_list" model="ir.ui.view">
        <field name="name">website.sourcing.list</field>
        <field name="model">website</field>
        <field name="arch" type="xml">
            <list string="独立采购网站" create="0" delete="0">
                <field name="name"/>
                <field name="domain"/>
                <field name="sourcing_brand_name"/>
                <field name="sourcing_service_email"/>
                <field name="sourcing_enabled"/>
            </list>
        </field>
    </record>

    <record id="view_ll_sourcing_website_form" model="ir.ui.view">
        <field name="name">website.sourcing.form</field>
        <field name="model">website</field>
        <field name="arch" type="xml">
            <form string="采购网站设置" create="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-info" role="alert">
                        此网站、菜单、询盘归属和内容资产与现有网站隔离。域名接入后，首页将进入采购服务站。
                    </div>
                    <group>
                        <group string="独立网站">
                            <field name="sourcing_enabled"/>
                            <field name="domain" placeholder="例如 https://sourcing.example.com"/>
                            <field name="sourcing_brand_name"/>
                            <field name="sourcing_tagline"/>
                        </group>
                        <group string="客户联系">
                            <field name="sourcing_service_email" widget="email"/>
                            <field name="sourcing_whatsapp_url" widget="url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="网站图片资产">
                            <field name="sourcing_asset_ids" context="{'default_website_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="image" widget="image" options="{'size': [96, 64]}"/>
                                    <field name="name"/>
                                    <field name="key"/>
                                    <field name="alt_text"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="服务与解决方案">
                            <field name="sourcing_offering_ids" context="{'default_website_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="kind"/>
                                    <field name="name"/>
                                    <field name="slug"/>
                                    <field name="image_asset_id"/>
                                    <field name="price_label" optional="hide"/>
                                    <field name="featured"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="询盘运营项目">
                            <field name="sourcing_project_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="operation_state"/>
                                    <field name="website_inquiry_enabled"/>
                                    <field name="user_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ll_sourcing_asset_list" model="ir.ui.view">
        <field name="name">ll.sourcing.asset.list</field>
        <field name="model">ll.sourcing.asset</field>
        <field name="arch" type="xml">
            <list string="采购网站图片资产">
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" options="{'size': [120, 80]}"/>
                <field name="name"/>
                <field name="key"/>
                <field name="website_id"/>
                <field name="alt_text"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_ll_sourcing_asset_form" model="ir.ui.view">
        <field name="name">ll.sourcing.asset.form</field>
        <field name="model">ll.sourcing.asset</field>
        <field name="arch" type="xml">
            <form string="网站图片资产">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="key"/>
                            <field name="website_id" options="{'no_create': True}"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="image" widget="image" class="oe_avatar"/>
                        </group>
                    </group>
                    <group string="无障碍与内容说明">
                        <field name="alt_text"/>
                        <field name="caption"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ll_sourcing_offering_list" model="ir.ui.view">
        <field name="name">ll.sourcing.offering.list</field>
        <field name="model">ll.sourcing.offering</field>
        <field name="arch" type="xml">
            <list string="服务与解决方案">
                <field name="sequence" widget="handle"/>
                <field name="kind"/>
                <field name="name"/>
                <field name="slug"/>
                <field name="website_id"/>
                <field name="image_asset_id"/>
                <field name="request_type"/>
                <field name="price_label" optional="show"/>
                <field name="featured"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_ll_sourcing_offering_form" model="ir.ui.view">
        <field name="name">ll.sourcing.offering.form</field>
        <field name="model">ll.sourcing.offering</field>
        <field name="arch" type="xml">
            <form string="服务与解决方案">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="slug"/>
                            <field name="website_id" options="{'no_create': True}"/>
                            <field name="request_type"/>
                            <field name="price_label"/>
                            <field name="badge"/>
                        </group>
                        <group>
                            <field name="icon"/>
                            <field name="image_asset_id" domain="[('website_id', '=', website_id)]"/>
                            <field name="sequence"/>
                            <field name="featured"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="kicker"/>
                        <field name="summary"/>
                        <field name="introduction"/>
                    </group>
                    <notebook>
                        <page string="核心能力（每行一项）"><field name="benefits" nolabel="1"/></page>
                        <page string="交付步骤（每行一步）"><field name="process" nolabel="1"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ll_sourcing_content_page_list" model="ir.ui.view">
        <field name="name">ll.sourcing.content.page.list</field>
        <field name="model">ll.sourcing.content.page</field>
        <field name="arch" type="xml">
            <list string="采购网站内容页面">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="page_type" widget="badge"/>
                <field name="source_path"/>
                <field name="website_id"/>
                <field name="imported_from_mirror"/>
                <field name="published"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_ll_sourcing_content_page_search" model="ir.ui.view">
        <field name="name">ll.sourcing.content.page.search</field>
        <field name="model">ll.sourcing.content.page</field>
        <field name="arch" type="xml">
            <search string="搜索采购网站页面">
                <field name="name"/>
                <field name="source_path"/>
                <field name="summary"/>
                <filter string="已发布" name="published" domain="[('published', '=', True)]"/>
                <filter string="本地镜像" name="mirror" domain="[('imported_from_mirror', '=', True)]"/>
                <separator/>
                <filter string="按页面类型分组" name="group_page_type" context="{'group_by': 'page_type'}"/>
            </search>
        </field>
    </record>
    <record id="view_ll_sourcing_content_page_form" model="ir.ui.view">
        <field name="name">ll.sourcing.content.page.form</field>
        <field name="model">ll.sourcing.content.page</field>
        <field name="arch" type="xml">
            <form string="采购网站内容页面">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="code"/><field name="source_path"/><field name="page_type"/><field name="website_id" options="{'no_create': True}"/></group>
                        <group><field name="sequence"/><field name="imported_from_mirror" readonly="1"/><field name="source_file" readonly="1"/><field name="source_hash" readonly="1"/><field name="published"/><field name="active"/></group>
                    </group>
                    <group><field name="kicker"/><field name="summary"/></group>
                    <notebook>
                        <page string="页面正文"><field name="body_html" widget="html" nolabel="1"/></page>
                        <page string="导入样式"><field name="source_stylesheets" readonly="1" nolabel="1"/></page>
                        <page string="指南章节" invisible="imported_from_mirror">
                            <field name="chapter_ids" context="{'default_page_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/><field name="name"/><field name="summary"/><field name="reading_time"/><field name="video_time"/><field name="target_url"/><field name="published"/><field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ll_sourcing_metric_list" model="ir.ui.view">
        <field name="name">ll.sourcing.metric.list</field><field name="model">ll.sourcing.metric</field>
        <field name="arch" type="xml"><list string="可信经营数据"><field name="sequence" widget="handle"/><field name="value_text"/><field name="label"/><field name="website_id"/><field name="verified"/><field name="published"/><field name="active"/></list></field>
    </record>
    <record id="view_ll_sourcing_metric_form" model="ir.ui.view">
        <field name="name">ll.sourcing.metric.form</field><field name="model">ll.sourcing.metric</field>
        <field name="arch" type="xml"><form string="可信经营数据"><sheet><group><group><field name="value_text"/><field name="label"/><field name="website_id" options="{'no_create': True}"/><field name="sequence"/></group><group><field name="verified"/><field name="published"/><field name="active"/></group></group><group string="核实依据"><field name="evidence_note"/><field name="evidence_url" widget="url"/></group></sheet></form></field>
    </record>

    <record id="view_ll_sourcing_testimonial_list" model="ir.ui.view">
        <field name="name">ll.sourcing.testimonial.list</field><field name="model">ll.sourcing.testimonial</field>
        <field name="arch" type="xml"><list string="客户评价"><field name="sequence" widget="handle"/><field name="client_name"/><field name="company_name"/><field name="website_id"/><field name="permission_confirmed"/><field name="verified"/><field name="published"/><field name="active"/></list></field>
    </record>
    <record id="view_ll_sourcing_testimonial_form" model="ir.ui.view">
        <field name="name">ll.sourcing.testimonial.form</field><field name="model">ll.sourcing.testimonial</field>
        <field name="arch" type="xml"><form string="客户评价"><sheet><group><group><field name="client_name"/><field name="client_role"/><field name="company_name"/><field name="website_id" options="{'no_create': True}"/></group><group><field name="client_image" widget="image" class="oe_avatar"/><field name="sequence"/><field name="active"/></group></group><group><field name="quote"/><field name="source_url" widget="url"/></group><group string="授权与发布"><field name="permission_confirmed"/><field name="verified"/><field name="published"/><field name="permission_note"/></group></sheet></form></field>
    </record>

    <record id="view_ll_sourcing_payment_method_list" model="ir.ui.view">
        <field name="name">ll.sourcing.payment.method.list</field><field name="model">ll.sourcing.payment.method</field>
        <field name="arch" type="xml"><list string="付款方式"><field name="sequence" widget="handle"/><field name="name"/><field name="website_id"/><field name="fee_note"/><field name="published"/><field name="active"/></list></field>
    </record>
    <record id="view_ll_sourcing_payment_method_form" model="ir.ui.view">
        <field name="name">ll.sourcing.payment.method.form</field><field name="model">ll.sourcing.payment.method</field>
        <field name="arch" type="xml"><form string="付款方式"><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="website_id" options="{'no_create': True}"/><field name="sequence"/></group><group><field name="published"/><field name="active"/></group></group><group><field name="summary"/><field name="fee_note"/><field name="verification_notice"/></group><group string="付款说明"><field name="instructions" widget="html" nolabel="1"/></group></sheet></form></field>
    </record>

    <record id="view_ll_sourcing_footer_column_list" model="ir.ui.view">
        <field name="name">ll.sourcing.footer.column.list</field><field name="model">ll.sourcing.footer.column</field>
        <field name="arch" type="xml"><list string="采购网站页脚"><field name="sequence" widget="handle"/><field name="name"/><field name="column_type"/><field name="website_id"/><field name="published"/><field name="active"/></list></field>
    </record>
    <record id="view_ll_sourcing_footer_column_form" model="ir.ui.view">
        <field name="name">ll.sourcing.footer.column.form</field><field name="model">ll.sourcing.footer.column</field>
        <field name="arch" type="xml"><form string="采购网站页脚栏目"><sheet><group><group><field name="name"/><field name="column_type"/><field name="website_id" options="{'no_create': True}"/></group><group><field name="sequence"/><field name="published"/><field name="active"/></group></group><group string="文本内容" invisible="column_type != 'content'"><field name="body_html" widget="html" nolabel="1"/></group><group string="链接列表" invisible="column_type != 'links'"><field name="link_ids" context="{'default_column_id': id}"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="url"/><field name="active"/></list></field></group></sheet></form></field>
    </record>

    <record id="view_ll_sourcing_product_category_list" model="ir.ui.view">
        <field name="name">ll.sourcing.product.category.list</field>
        <field name="model">product.public.category</field>
        <field name="arch" type="xml">
            <list string="产品分类落地页">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="sourcing_hero_subtitle" optional="show"/>
                <field name="website_id"/>
            </list>
        </field>
    </record>
    <record id="view_ll_sourcing_product_category_form" model="ir.ui.view">
        <field name="name">ll.sourcing.product.category.form</field>
        <field name="model">product.public.category</field>
        <field name="arch" type="xml">
            <form string="产品分类落地页">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="子分类" bg_color="text-bg-info" invisible="not parent_id"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title"><h1><field name="name" placeholder="产品分类名称"/></h1></div>
                    <group>
                        <group>
                            <field name="website_id" options="{'no_create': True}"/>
                            <field name="parent_id" domain="[('website_id', '=', website_id)]"/>
                            <field name="sequence"/>
                        </group>
                        <group string="落地页主视觉">
                            <field name="sourcing_image_asset_id" domain="[('website_id', '=', website_id)]"/>
                            <field name="sourcing_hero_subtitle"/>
                            <field name="sourcing_inquiry_heading"/>
                        </group>
                    </group>
                    <group string="三项分类亮点" invisible="parent_id">
                        <field name="sourcing_highlight_1"/>
                        <field name="sourcing_highlight_2"/>
                        <field name="sourcing_highlight_3"/>
                    </group>
                    <notebook>
                        <page string="分类介绍"><field name="website_description" widget="html" nolabel="1"/></page>
                        <page string="子分类" invisible="parent_id"><field name="child_id" context="{'default_website_id': website_id}"><list><field name="sequence" widget="handle"/><field name="name"/><field name="sourcing_hero_subtitle" optional="show"/><field name="website_id" optional="hide"/></list></field></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ll_sourcing_website_menu_list" model="ir.ui.view">
        <field name="name">ll.sourcing.website.menu.list</field>
        <field name="model">website.menu</field>
        <field name="arch" type="xml">
            <list string="网站头部导航">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="url"/>
                <field name="new_window"/>
                <field name="is_visible"/>
            </list>
        </field>
    </record>
    <record id="view_ll_sourcing_website_menu_form" model="ir.ui.view">
        <field name="name">ll.sourcing.website.menu.form</field>
        <field name="model">website.menu</field>
        <field name="arch" type="xml">
            <form string="网站头部导航">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="url"/><field name="parent_id" domain="[('website_id', '=', website_id)]"/><field name="sequence"/></group>
                        <group><field name="website_id" options="{'no_create': True}"/><field name="new_window"/><field name="is_visible" readonly="1"/></group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ll_sourcing_websites" model="ir.actions.act_window">
        <field name="name">独立采购网站</field>
        <field name="res_model">website</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('sourcing_enabled', '=', True)]</field>
        <field name="views" eval="[(ref('view_ll_sourcing_website_list'), 'list'), (ref('view_ll_sourcing_website_form'), 'form')]"/>
    </record>
    <record id="action_ll_sourcing_assets" model="ir.actions.act_window">
        <field name="name">网站图片资产</field>
        <field name="res_model">ll.sourcing.asset</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ll_sourcing_offerings" model="ir.actions.act_window">
        <field name="name">服务与解决方案</field>
        <field name="res_model">ll.sourcing.offering</field>
        <field name="view_mode">list,form</field>
