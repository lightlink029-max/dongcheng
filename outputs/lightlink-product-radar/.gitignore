# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.tmp-edge-*/
# local evidence exports, screenshots and process logs
/assist-*.json
/images-*.json
/lightlink-buyer-research-*.json
/opportunity-evidence-*.json
/research-*.json
/trade-detail-*.json
/trade-observations-*.json
/opportunity-acceptance.png
/*.log
/*.tsbuildinfo
/backups/
/data-imports/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
