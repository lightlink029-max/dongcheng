<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_shopify_process_jobs" model="ir.cron">
        <field name="name">LightLink Shopify：处理后台任务</field>
        <field name="model_id" ref="model_ll_shopify_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_jobs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_shopify_schedule_sync" model="ir.cron">
        <field name="name">LightLink Shopify：安排订单与库存同步</field>
        <field name="model_id" ref="model_ll_shopify_store"/>
        <field name="state">code</field>
        <field name="code">model._cron_schedule_sync()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
