<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_lightlink_shopify" model="ir.module.category">
        <field name="name">LightLink Shopify</field>
        <field name="sequence">45</field>
    </record>

    <record id="privilege_lightlink_shopify" model="res.groups.privilege">
        <field name="name">LightLink Shopify</field>
        <field name="sequence">45</field>
        <field name="category_id" ref="module_category_lightlink_shopify"/>
    </record>

    <record id="group_shopify_viewer" model="res.groups">
        <field name="name">Shopify 只读</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_lightlink_shopify"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_shopify_operator" model="res.groups">
        <field name="name">Shopify 运营</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_lightlink_shopify"/>
        <field name="implied_ids" eval="[(4, ref('group_shopify_viewer'))]"/>
    </record>
    <record id="group_shopify_manager" model="res.groups">
        <field name="name">Shopify 管理员</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_lightlink_shopify"/>
        <field name="implied_ids" eval="[(4, ref('group_shopify_operator'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_shopify_manager'))]"/>
    </record>

    <record id="rule_shopify_store_company" model="ir.rule">
        <field name="name">Shopify 店铺公司隔离</field>
        <field name="model_id" ref="model_ll_shopify_store"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_shopify_viewer'))]"/>
    </record>
    <record id="rule_shopify_channel_product_company" model="ir.rule">
        <field name="name">Shopify 渠道商品公司隔离</field>
        <field name="model_id" ref="model_ll_shopify_channel_product"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_shopify_viewer'))]"/>
    </record>
    <record id="rule_shopify_channel_image_company" model="ir.rule">
        <field name="name">Shopify 渠道图片公司隔离</field>
        <field name="model_id" ref="model_ll_shopify_channel_image"/>
        <field name="domain_force">[('channel_product_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_shopify_viewer'))]"/>
    </record>
    <record id="rule_shopify_channel_variant_company" model="ir.rule">
        <field name="name">Shopify 渠道变体公司隔离</field>
        <field name="model_id" ref="model_ll_shopify_channel_variant"/>
        <field name="domain_force">[('channel_product_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_shopify_viewer'))]"/>
    </record>
    <record id="rule_shopify_collection_company" model="ir.rule">
        <field name="name">Shopify 分类公司隔离</field>
        <field name="model_id" ref="model_ll_shopify_collection"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_shopify_viewer'))]"/>
    </record>
    <record id="rule_shopify_location_company" model="ir.rule">
        <field name="name">Shopify 库位映射公司隔离</field>
        <field name="model_id" ref="model_ll_shopify_location_map"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_shopify_viewer'))]"/>
    </record>
    <record id="rule_shopify_job_company" model="ir.rule">
        <field name="name">Shopify 任务公司隔离</field>
        <field name="model_id" ref="model_ll_shopify_job"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_shopify_viewer'))]"/>
    </record>
    <record id="rule_shopify_order_company" model="ir.rule">
        <field name="name">Shopify 订单绑定公司隔离</field>
        <field name="model_id" ref="model_ll_shopify_order_binding"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_shopify_viewer'))]"/>
    </record>
    <record id="rule_shopify_inquiry_company" model="ir.rule">
        <field name="name">Shopify 询盘公司隔离</field>
        <field name="model_id" ref="model_ll_shopify_inquiry"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_shopify_viewer'))]"/>
    </record>
    <record id="rule_shopify_webhook_event_company" model="ir.rule">
        <field name="name">Shopify Webhook公司隔离</field>
        <field name="model_id" ref="model_ll_shopify_webhook_event"/>
        <field name="domain_force">[('store_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_shopify_manager'))]"/>
    </record>
</odoo>
