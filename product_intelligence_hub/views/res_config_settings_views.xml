<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_product_intelligence_settings" model="ir.actions.act_window">
        <field name="name">产品智能设置</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'product_intelligence_hub'}</field>
    </record>

    <record id="res_config_settings_view_form_product_intelligence" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.product.intelligence</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="产品智能" name="product_intelligence_hub" groups="product_intelligence_hub.group_product_intelligence_manager">
                    <block title="决策阈值">
                        <setting string="批准阈值" help="达到或超过该分数的候选产品将被建议批准。">
                            <field name="pi_approval_threshold"/>
                        </setting>
                        <setting string="复核阈值" help="低于该分数的候选产品将被建议淘汰。">
                            <field name="pi_review_threshold"/>
                        </setting>
                    </block>
                    <block title="评分权重" help="各项权重之和必须为 100%。">
                        <setting string="需求"><field name="pi_weight_demand"/></setting>
                        <setting string="增长"><field name="pi_weight_growth"/></setting>
                        <setting string="利润"><field name="pi_weight_margin"/></setting>
                        <setting string="竞争"><field name="pi_weight_competition"/></setting>
                        <setting string="物流"><field name="pi_weight_logistics"/></setting>
                        <setting string="合规"><field name="pi_weight_compliance"/></setting>
                        <setting string="内容潜力"><field name="pi_weight_content"/></setting>
                    </block>
                    <block title="阿里云 OSS 图片存储" help="启用后，新采集的产品主图会复制到自己的 OSS；上传失败不会中断采集。">
                        <setting string="启用 OSS 图片存储">
                            <field name="pi_oss_enabled"/>
                        </setting>
                        <setting string="OSS 连接" invisible="not pi_oss_enabled">
                            <div class="content-group">
                                <div class="row mt16"><label for="pi_oss_endpoint" class="col-lg-3 o_light_label"/><field name="pi_oss_endpoint" placeholder="oss-cn-hangzhou.aliyuncs.com"/></div>
                                <div class="row mt16"><label for="pi_oss_bucket" class="col-lg-3 o_light_label"/><field name="pi_oss_bucket"/></div>
                                <div class="row mt16"><label for="pi_oss_access_key_id" class="col-lg-3 o_light_label"/><field name="pi_oss_access_key_id"/></div>
                                <div class="row mt16"><label for="pi_oss_access_key_secret" class="col-lg-3 o_light_label"/><field name="pi_oss_access_key_secret" password="True"/></div>
                            </div>
                        </setting>
                        <setting string="对象路径和访问域名" invisible="not pi_oss_enabled">
                            <div class="content-group">
                                <div class="row mt16"><label for="pi_oss_prefix" class="col-lg-3 o_light_label"/><field name="pi_oss_prefix" placeholder="product-intelligence"/></div>
                                <div class="row mt16"><label for="pi_oss_public_base_url" class="col-lg-3 o_light_label"/><field name="pi_oss_public_base_url" placeholder="https://img.example.com"/></div>
                            </div>
                        </setting>
                        <setting string="删除联动" help="启用后，删除候选产品记录时同时删除由该记录上传的 OSS 对象。" invisible="not pi_oss_enabled">
                            <field name="pi_oss_delete_on_unlink"/>
                        </setting>
                    </block>
                    <block title="网站以图搜产品（Qdrant Cloud）" help="客户上传一张参考图片，系统返回视觉上最相似的已发布商品。原图仍保存在 Odoo，Qdrant 只保存图片向量和商品编号。">
                        <setting string="启用以图搜产品" help="连接测试成功并建立商品索引后，再向网站访客显示搜索入口。">
                            <field name="pi_qdrant_enabled"/>
                        </setting>
                        <setting string="Qdrant 连接" invisible="not pi_qdrant_enabled">
                            <div class="content-group">
                                <div class="row mt16"><label for="pi_qdrant_url" class="col-lg-3 o_light_label"/><field name="pi_qdrant_url" placeholder="https://xxxx.cloud.qdrant.io:6333"/></div>
                                <div class="row mt16"><label for="pi_qdrant_api_key" class="col-lg-3 o_light_label"/><field name="pi_qdrant_api_key" password="True"/></div>
                                <div class="row mt16"><label for="pi_qdrant_collection" class="col-lg-3 o_light_label"/><field name="pi_qdrant_collection"/></div>
                                <button name="action_pi_qdrant_test_connection" type="object" string="测试连接并准备集合" class="btn-secondary mt16"/>
                            </div>
                        </setting>
                        <setting string="图片向量生成" help="默认在 Odoo 内用 Pillow 生成免费的 512 维视觉特征，Qdrant 只负责相似度检索，不消耗付费推理。" invisible="not pi_qdrant_enabled">
                            <div class="content-group">
                                <div class="row mt16"><label for="pi_qdrant_image_model" class="col-lg-3 o_light_label"/><field name="pi_qdrant_image_model"/></div>
                                <div class="row mt16"><label for="pi_qdrant_vector_dimension" class="col-lg-3 o_light_label"/><field name="pi_qdrant_vector_dimension"/></div>
                            </div>
                        </setting>
                        <setting string="搜索质量和安全限制" invisible="not pi_qdrant_enabled">
                            <div class="content-group">
                                <div class="row mt16"><label for="pi_qdrant_result_limit" class="col-lg-3 o_light_label"/><field name="pi_qdrant_result_limit"/></div>
                                <div class="row mt16"><label for="pi_qdrant_score_threshold" class="col-lg-3 o_light_label"/><field name="pi_qdrant_score_threshold"/></div>
                                <div class="row mt16"><label for="pi_qdrant_upload_limit_mb" class="col-lg-3 o_light_label"/><field name="pi_qdrant_upload_limit_mb"/></div>
                                <div class="row mt16"><label for="pi_qdrant_rate_limit" class="col-lg-3 o_light_label"/><field name="pi_qdrant_rate_limit"/></div>
                            </div>
                        </setting>
                        <setting string="商品图片索引" help="首次启用或更换模型后执行一次；之后商品图片变化会自动进入后台增量索引。" invisible="not pi_qdrant_enabled">
                            <button name="action_pi_qdrant_reindex_all" type="object" string="重建全部商品图片索引" class="btn-secondary"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
