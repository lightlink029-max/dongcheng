<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_intelligence_sourcing_offer_search" model="ir.ui.view">
        <field name="name">product.intelligence.sourcing.offer.search</field>
        <field name="model">product.intelligence.sourcing.offer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="candidate_id"/>
                <field name="supplier_name"/>
                <field name="merchant_features"/>
                <field name="merchant_join_time"/>
                <filter name="cheaper_than_opportunity" string="1688价格更低" domain="[('is_cheaper_than_opportunity', '=', True)]"/>
                <separator/>
                <filter name="powerful_merchant" string="实力商家" domain="[('merchant_features', 'ilike', '实力商家')]"/>
                <filter name="super_factory" string="超级工厂" domain="[('merchant_features', 'ilike', '超级工厂')]"/>
                <filter name="source_flagship" string="源头旗舰店" domain="[('merchant_features', 'ilike', '源头旗舰店')]"/>
                <group name="group_by">
                    <filter name="group_candidate" string="产品机会" context="{'group_by': 'candidate_id'}"/>
                    <filter name="group_supplier" string="供应商" context="{'group_by': 'supplier_name'}"/>
                    <filter name="group_feature" string="商家特色" context="{'group_by': 'merchant_features'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_product_intelligence_sourcing_offer_list" model="ir.ui.view">
        <field name="name">product.intelligence.sourcing.offer.list</field>
        <field name="model">product.intelligence.sourcing.offer</field>
        <field name="arch" type="xml">
            <list decoration-success="is_preferred" decoration-info="is_cheaper_than_opportunity" default_order="is_preferred desc, is_cheaper_than_opportunity desc, price_difference desc">
                <header>
                    <button name="action_bulk_delete" type="object" string="删除所选货源" display="always" class="btn-secondary" groups="product_intelligence_hub.group_product_intelligence_manager" confirm="删除后无法恢复，确认删除所选1688货源吗？"/>
                </header>
                <field name="is_preferred" readonly="1"/>
                <field name="candidate_id" optional="show"/>
                <field name="image_512" widget="image" string="主图" options="{'size': [80, 80]}" optional="show"/>
                <field name="image_url" widget="url" optional="hide"/>
                <field name="name"/>
                <field name="supplier_name"/>
                <field name="merchant_features" optional="show"/>
                <field name="merchant_join_time" optional="show"/>
                <field name="supplier_location" optional="show"/>
                <field name="price_text" optional="show"/>
                <field name="purchase_price"/>
                <field name="opportunity_price" optional="show"/>
                <field name="price_difference" optional="show"/>
                <field name="is_cheaper_than_opportunity" readonly="1" optional="show"/>
                <field name="minimum_order_qty"/>
                <field name="sales_text" optional="show"/>
                <field name="ai_opportunity_snapshot" optional="hide"/>
                <field name="delivery_days" optional="show"/>
                <field name="estimated_total_cost"/>
                <field name="estimated_profit"/>
                <field name="estimated_margin_percent" widget="percentage"/>
                <field name="contact_phone" optional="show"/>
                <field name="product_url" widget="url" optional="show"/>
                <button name="action_set_preferred" type="object" string="设为推荐" icon="fa-star"/>
            </list>
        </field>
    </record>

    <record id="view_product_intelligence_sourcing_offer_form" model="ir.ui.view">
        <field name="name">product.intelligence.sourcing.offer.form</field>
        <field name="model">product.intelligence.sourcing.offer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_preferred" type="object" string="设为推荐货源" class="btn-primary" invisible="is_preferred"/>
                    <button name="action_open_source" type="object" string="打开1688商品"/>
                </header>
                <sheet>
                    <field name="image_512" widget="image" class="oe_avatar" options="{'preview_image': 'image_512'}"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="货源商品">
                            <field name="candidate_id"/>
                            <field name="platform"/>
                            <field name="external_id"/>
                            <field name="product_url" widget="url"/>
                            <field name="image_url" widget="url"/>
                            <field name="price_text"/>
                            <field name="purchase_price"/>
                            <field name="minimum_order_qty"/>
                            <field name="sales_text"/>
                            <field name="delivery_days"/>
                        </group>
                        <group string="供应商">
                            <field name="supplier_name"/>
                            <field name="merchant_features"/>
                            <field name="merchant_join_time"/>
                            <field name="supplier_url" widget="url"/>
                            <field name="supplier_location"/>
                            <field name="contact_name"/>
                            <field name="contact_phone"/>
                            <field name="contact_details"/>
                            <field name="supplier_partner_id"/>
                            <field name="supplierinfo_id"/>
                        </group>
                    </group>
                    <group string="利润测算">
                        <group>
                            <field name="domestic_freight"/>
                            <field name="estimated_total_cost"/>
                        </group>
                        <group>
                            <field name="estimated_profit"/>
                            <field name="estimated_margin_percent" widget="percentage"/>
                            <field name="is_preferred"/>
                        </group>
                    </group>
                    <group string="价格比较">
                        <field name="opportunity_price"/>
                        <field name="purchase_price"/>
                        <field name="price_difference"/>
                        <field name="is_cheaper_than_opportunity"/>
                    </group>
                    <group string="AI商机识别">
                        <field name="ai_opportunity_snapshot" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_intelligence_sourcing_offer" model="ir.actions.act_window">
        <field name="name">1688货源报价</field>
        <field name="res_model">product.intelligence.sourcing.offer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_product_intelligence_sourcing_offer_search"/>
    </record>
</odoo>
