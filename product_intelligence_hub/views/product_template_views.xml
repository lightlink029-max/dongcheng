<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_product_intelligence" model="ir.ui.view">
        <field name="name">product.template.form.product.intelligence</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_product_intelligence_candidate" type="object"
                        class="oe_stat_button" icon="fa-lightbulb-o" invisible="not pi_candidate_id">
                    <span class="o_stat_text">产品机会</span>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="选品来源与详情" name="product_intelligence_details" invisible="not pi_candidate_id">
                    <button name="action_sync_product_intelligence_details" type="object"
                            string="从产品机会重新同步" class="btn-secondary mb-3"/>
                    <group string="来源概览" col="4">
                        <field name="pi_candidate_id"/>
                        <field name="pi_source_name"/>
                        <field name="pi_supplier_name"/>
                        <field name="pi_source_category"/>
                        <field name="pi_external_url" widget="url"/>
                        <field name="pi_detail_updated_at"/>
                    </group>
                    <group string="网站产品详情" col="2">
                        <field name="description_ecommerce" string="电子商务说明"
                               placeholder="由核心属性、重要属性、包装和发货信息自动整理生成"/>
                    </group>
                    <group string="产品视频" col="1">
                        <field name="pi_video_ids" readonly="1">
                            <list>
                                <field name="sequence"/>
                                <field name="name"/>
                                <field name="filename"/>
                                <field name="source_url" widget="url" optional="show"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_product_supplierinfo_list_product_intelligence" model="ir.ui.view">
        <field name="name">product.supplierinfo.list.product.intelligence</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='delay']" position="after">
                <field name="pi_sourcing_offer_id" column_invisible="True"/>
                <field name="pi_source_platform" optional="show"/>
                <field name="pi_supplier_url" widget="url" optional="show"/>
                <field name="pi_product_url" widget="url" optional="show"/>
                <field name="pi_contact_enrichment_state" optional="show"/>
                <button name="action_open_pi_sourcing_offer" type="object"
                        string="来源详情" icon="fa-external-link"
                        invisible="not pi_sourcing_offer_id"/>
                <button name="action_queue_pi_supplier_contact" type="object"
                        string="补充联系方式" icon="fa-address-card"
                        invisible="not pi_sourcing_offer_id or pi_source_platform != 'yiwugo'"/>
            </xpath>
        </field>
    </record>
</odoo>
