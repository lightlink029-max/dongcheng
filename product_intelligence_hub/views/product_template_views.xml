<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_product_intelligence" model="ir.ui.view">
        <field name="name">product.template.form.product.intelligence</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_product_intelligence_candidate" type="object"
                        class="oe_stat_button" icon="fa-lightbulb-o" invisible="not pi_candidate_id">
                    <span class="o_stat_text">产品机会</span>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="选品来源与详情" name="product_intelligence_details" invisible="not pi_candidate_id">
                    <button name="action_sync_product_intelligence_details" type="object"
                            string="从产品机会重新同步" class="btn-secondary mb-3"/>
                    <group string="来源概览" col="4">
                        <field name="pi_candidate_id"/>
                        <field name="pi_source_name"/>
                        <field name="pi_supplier_name"/>
                        <field name="pi_source_category"/>
                        <field name="pi_external_url" widget="url"/>
                        <field name="pi_detail_updated_at"/>
                    </group>
                    <group string="产品采集详情" col="2">
                        <field name="pi_core_industry_attributes"/>
                        <field name="pi_important_attributes"/>
                        <field name="pi_packaging_information"/>
                        <field name="pi_shipping_information"/>
                    </group>
                    <group string="网站翻译文案" col="2">
                        <field name="description_sale" string="产品详情翻译源文案"
                               placeholder="由核心属性、重要属性、包装和发货信息自动整理生成"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
