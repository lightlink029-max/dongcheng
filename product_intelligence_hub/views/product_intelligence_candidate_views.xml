<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_intelligence_candidate_search" model="ir.ui.view">
        <field name="name">product.intelligence.candidate.search</field>
        <field name="model">product.intelligence.candidate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="source_id"/>
                <field name="category"/>
                <field name="target_country_id"/>
                <field name="owner_id"/>
                <filter name="high_potential" string="高潜力" domain="[('recommendation', '=', 'approve')]"/>
                <filter name="needs_review" string="待复核" domain="[('stage', '=', 'review')]"/>
                <separator/>
                <filter name="my_candidates" string="我的候选产品" domain="[('owner_id', '=', uid)]"/>
                <group name="group_by">
                    <filter name="group_stage" string="OODA 阶段" context="{'group_by': 'stage'}"/>
                    <filter name="group_source" string="来源" context="{'group_by': 'source_id'}"/>
                    <filter name="group_country" string="目标国家/地区" context="{'group_by': 'target_country_id'}"/>
                    <filter name="group_category" string="分类" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_product_intelligence_candidate_list" model="ir.ui.view">
        <field name="name">product.intelligence.candidate.list</field>
        <field name="model">product.intelligence.candidate</field>
        <field name="arch" type="xml">
            <list decoration-success="recommendation == 'approve'" decoration-warning="recommendation == 'review'" decoration-danger="recommendation == 'reject'">
                <field name="reference"/>
                <field name="name"/>
                <field name="source_id"/>
                <field name="category" optional="show"/>
                <field name="target_country_id" optional="show"/>
                <field name="supplier_price" optional="show"/>
                <field name="target_sale_price" optional="show"/>
                <field name="estimated_margin_percent" string="利润率 %" optional="show"/>
                <field name="total_score" widget="progressbar"/>
                <field name="recommendation" widget="badge"/>
                <field name="stage" widget="badge"/>
                <field name="owner_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_product_intelligence_candidate_kanban" model="ir.ui.view">
        <field name="name">product.intelligence.candidate.kanban</field>
        <field name="model">product.intelligence.candidate</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage" class="o_kanban_small_column" quick_create="false">
                <field name="name"/>
                <field name="reference"/>
                <field name="source_id"/>
                <field name="target_country_id"/>
                <field name="total_score"/>
                <field name="recommendation"/>
                <field name="owner_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between mb-2">
                            <strong class="text-truncate"><field name="name"/></strong>
                            <field name="recommendation" widget="badge"/>
                        </div>
                        <div class="text-muted"><field name="reference"/> · <field name="source_id"/></div>
                        <div t-if="record.target_country_id.value" class="mt-1">
                            <i class="fa fa-globe me-1"/><field name="target_country_id"/>
                        </div>
                        <div class="mt-2">
                            <span class="fw-bold">评分：</span><field name="total_score"/>
                        </div>
                        <footer class="mt-2">
                            <field name="owner_id" widget="many2one_avatar_user"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_product_intelligence_candidate_form" model="ir.ui.view">
        <field name="name">product.intelligence.candidate.form</field>
        <field name="model">product.intelligence.candidate</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_orient" type="object" string="开始分析" class="btn-primary" invisible="stage != 'observe'"/>
                    <button name="action_submit_review" type="object" string="提交决策" class="btn-primary" invisible="stage != 'orient'"/>
                    <button name="action_approve" type="object" string="批准" class="btn-primary" invisible="stage != 'review'" groups="product_intelligence_hub.group_product_intelligence_manager"/>
                    <button name="action_reject" type="object" string="淘汰" invisible="stage not in ('review', 'approved')" groups="product_intelligence_hub.group_product_intelligence_manager"/>
                    <button name="action_create_product" type="object" string="创建 Odoo 产品" class="btn-primary" invisible="stage != 'approved'"/>
                    <field name="stage" widget="statusbar" statusbar_visible="observe,orient,review,approved,executed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_product" type="object" class="oe_stat_button" icon="fa-cube" invisible="not product_tmpl_id">
                            <span class="o_stat_text">Odoo 产品</span>
                        </button>
                    </div>
                    <field name="product_tmpl_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                        <div><field name="reference" readonly="1"/></div>
                    </div>
                    <group>
                        <group>
                            <field name="source_id"/>
                            <field name="external_id"/>
                            <field name="external_url" widget="url"/>
                            <field name="category"/>
                            <field name="target_country_id"/>
                        </group>
                        <group>
                            <field name="owner_id"/>
                            <field name="data_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="recommendation" widget="badge" readonly="1"/>
                            <field name="total_score" widget="progressbar" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="市场数据">
                            <group>
                                <group string="商业数据">
                                    <field name="supplier_price"/>
                                    <field name="target_sale_price"/>
                                    <field name="logistics_cost"/>
                                    <field name="other_cost"/>
                                    <field name="estimated_margin_percent" readonly="1"/>
                                </group>
                                <group string="市场">
                                    <field name="monthly_search_volume"/>
                                    <field name="trend_growth_percent"/>
                                    <field name="competitor_count"/>
                                    <field name="supplier_count"/>
                                    <field name="minimum_order_qty"/>
                                    <field name="lead_time_days"/>
                                </group>
                            </group>
                        </page>
                        <page string="评分">
                            <group>
                                <group>
                                    <field name="demand_score"/>
                                    <field name="growth_score"/>
                                    <field name="margin_score"/>
                                    <field name="competition_score"/>
                                </group>
                                <group>
                                    <field name="logistics_score"/>
                                    <field name="compliance_score"/>
                                    <field name="content_score"/>
                                </group>
                            </group>
                        </page>
                        <page string="产品简报">
                            <field name="description"/>
                        </page>
                        <page string="决策">
                            <field name="decision_notes"/>
                            <field name="rejection_reason" invisible="stage != 'rejected'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_product_intelligence_candidate_graph" model="ir.ui.view">
        <field name="name">product.intelligence.candidate.graph</field>
        <field name="model">product.intelligence.candidate</field>
        <field name="arch" type="xml">
            <graph string="机会评分" type="bar">
                <field name="stage"/>
                <field name="total_score" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_product_intelligence_candidate_pivot" model="ir.ui.view">
        <field name="name">product.intelligence.candidate.pivot</field>
        <field name="model">product.intelligence.candidate</field>
        <field name="arch" type="xml">
            <pivot string="产品机会分析">
                <field name="source_id" type="row"/>
                <field name="stage" type="col"/>
                <field name="total_score" type="measure"/>
                <field name="estimated_margin_percent" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_product_intelligence_candidate" model="ir.actions.act_window">
        <field name="name">产品机会</field>
        <field name="res_model">product.intelligence.candidate</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_product_intelligence_candidate_search"/>
        <field name="context">{'search_default_my_candidates': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">创建第一个产品机会</p>
            <p>收集证据、评估机会，并按照 OODA 决策流程推进。</p>
        </field>
    </record>
</odoo>
