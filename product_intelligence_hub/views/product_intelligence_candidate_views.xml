<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_intelligence_candidate_search" model="ir.ui.view">
        <field name="name">product.intelligence.candidate.search</field>
        <field name="model">product.intelligence.candidate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="source_id"/>
                <field name="category"/>
                <field name="target_country_id"/>
                <field name="owner_id"/>
                <filter name="high_potential" string="高潜力" domain="[('recommendation', '=', 'approve')]"/>
                <filter name="needs_review" string="待复核" domain="[('stage', '=', 'review')]"/>
                <separator/>
                <filter name="my_candidates" string="我的候选产品" domain="[('owner_id', '=', uid)]"/>
                <group name="group_by">
                    <filter name="group_stage" string="OODA 阶段" context="{'group_by': 'stage'}"/>
                    <filter name="group_source" string="来源" context="{'group_by': 'source_id'}"/>
                    <filter name="group_country" string="目标国家/地区" context="{'group_by': 'target_country_id'}"/>
                    <filter name="group_category" string="分类" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_product_intelligence_candidate_list" model="ir.ui.view">
        <field name="name">product.intelligence.candidate.list</field>
        <field name="model">product.intelligence.candidate</field>
        <field name="arch" type="xml">
            <list decoration-success="recommendation == 'approve'" decoration-warning="recommendation == 'review'" decoration-danger="recommendation == 'reject'">
                <header>
                    <button name="action_queue_detail_enrichment" type="object" string="补充详情" display="always" class="btn-primary"/>
                    <button name="action_sync_product_details" type="object" string="同步详情到 Odoo 产品" display="always"/>
                    <button name="action_bulk_delete" type="object" string="删除所选产品" display="always" groups="product_intelligence_hub.group_product_intelligence_manager" confirm="删除后无法恢复，确认删除所选候选产品吗？"/>
                </header>
                <field name="image_preview" widget="html"/>
                <field name="reference"/>
                <field name="name"/>
                <field name="source_id"/>
                <field name="category" optional="show"/>
                <field name="detail_state" widget="badge" optional="show"/>
                <field name="target_country_id" optional="show"/>
                <field name="price_text" string="价格区间" optional="show"/>
                <field name="supplier_price" optional="hide"/>
                <field name="heat_score" optional="show"/>
                <field name="sales_7d" optional="hide"/>
                <field name="sales_30d" optional="hide"/>
                <field name="sales_180d" optional="hide"/>
                <field name="displayed_sales" optional="show"/>
                <field name="sales_amount" optional="hide"/>
                <field name="inquiry_count" optional="show"/>
                <field name="transaction_count" optional="hide"/>
                <field name="search_rank" optional="hide"/>
                <field name="target_sale_price" optional="show"/>
                <field name="estimated_margin_percent" optional="show"/>
                <field name="total_score" widget="progressbar"/>
                <field name="recommendation" widget="badge"/>
                <field name="stage" widget="badge"/>
                <field name="owner_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_product_intelligence_candidate_kanban" model="ir.ui.view">
        <field name="name">product.intelligence.candidate.kanban</field>
        <field name="model">product.intelligence.candidate</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage" class="o_kanban_small_column" quick_create="false">
                <field name="name"/>
                <field name="reference"/>
                <field name="source_id"/>
                <field name="target_country_id"/>
                <field name="total_score"/>
                <field name="recommendation"/>
                <field name="owner_id"/>
                <field name="image_preview"/>
                <templates>
                    <t t-name="card">
                        <div class="mb-2"><field name="image_preview" widget="html"/></div>
                        <field name="image_storage_state"/>
                        <div class="d-flex justify-content-between mb-2">
                            <strong class="text-truncate"><field name="name"/></strong>
                            <field name="recommendation" widget="badge"/>
                        </div>
                        <div class="text-muted"><field name="reference"/> · <field name="source_id"/></div>
                        <div t-if="record.target_country_id.value" class="mt-1">
                            <i class="fa fa-globe me-1"/><field name="target_country_id"/>
                        </div>
                        <div class="mt-2">
                            <span class="fw-bold">评分：</span><field name="total_score"/>
                        </div>
                        <footer class="mt-2">
                            <field name="owner_id" widget="many2one_avatar_user"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_product_intelligence_candidate_form" model="ir.ui.view">
        <field name="name">product.intelligence.candidate.form</field>
        <field name="model">product.intelligence.candidate</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_orient" type="object" string="开始分析" class="btn-primary" invisible="stage != 'observe'"/>
                    <button name="action_submit_review" type="object" string="提交决策" class="btn-primary" invisible="stage != 'orient'"/>
                    <button name="action_approve" type="object" string="批准" class="btn-primary" invisible="stage != 'review'" groups="product_intelligence_hub.group_product_intelligence_manager"/>
                    <button name="action_reject" type="object" string="淘汰" invisible="stage not in ('review', 'approved')" groups="product_intelligence_hub.group_product_intelligence_manager"/>
                    <button name="action_open_1688_search" type="object" string="1688找货" class="btn-secondary" invisible="stage not in ('orient', 'review')"/>
                    <button name="action_create_product" type="object" string="创建 Odoo 产品" class="btn-primary" invisible="stage != 'approved'"/>
                    <button name="action_sync_product_details" type="object" string="同步详情到 Odoo 产品" class="btn-secondary" invisible="not product_tmpl_id"/>
                    <field name="stage" widget="statusbar" statusbar_visible="observe,orient,review,approved,executed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_product" type="object" class="oe_stat_button" icon="fa-cube" invisible="not product_tmpl_id">
                            <span class="o_stat_text">Odoo 产品</span>
                        </button>
                        <button name="action_view_sourcing_offers" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="sourcing_offer_count" widget="statinfo" string="1688货源"/>
                        </button>
                    </div>
                    <field name="product_tmpl_id" invisible="1"/>
                    <div class="oe_title">
                        <field name="image_preview" widget="html" nolabel="1"/>
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                        <div><field name="reference" readonly="1"/></div>
                    </div>
                    <group>
                        <group>
                            <field name="source_id"/>
                            <field name="external_id"/>
                            <field name="external_url" widget="url"/>
                            <field name="image_url" widget="url"/>
                            <field name="original_image_url" widget="url"/>
                            <field name="oss_object_key"/>
                            <field name="image_storage_state"/>
                            <field name="image_storage_error" invisible="image_storage_state != 'failed'"/>
                            <button name="action_store_image_oss" type="object" string="保存图片到 OSS" class="btn-secondary" invisible="image_storage_state == 'stored'"/>
                            <field name="category"/>
                            <field name="target_country_id"/>
                        </group>
                        <group>
                            <field name="owner_id"/>
                            <field name="data_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="recommendation" widget="badge" readonly="1"/>
                            <field name="total_score" widget="progressbar" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="产品详情">
                            <group>
                                <field name="detail_state" widget="badge"/>
                                <field name="detail_updated_at"/>
                                <field name="detail_error" invisible="detail_state != 'failed'"/>
                            </group>
                            <group>
                                <field name="core_industry_attributes"/>
                                <field name="important_attributes"/>
                                <field name="packaging_information"/>
                                <field name="shipping_information"/>
                            </group>
                            <button name="action_queue_detail_enrichment" type="object" string="加入补充详情队列" class="btn-primary"/>
                        </page>
                        <page string="图片与视频">
                            <div class="alert alert-info" role="alert">
                                补充详情时自动获取商品详情页中的图片和视频。同步到 Odoo 产品后，将显示在电子商务媒体中。
                            </div>
                            <field name="media_ids" context="{'default_candidate_id': id}">
                                <list editable="bottom" default_order="sequence, id">
                                    <field name="sequence" widget="handle"/>
                                    <field name="preview" widget="html" readonly="1"/>
                                    <field name="media_type"/>
                                    <field name="name"/>
                                    <field name="source_url" widget="url"/>
                                    <field name="product_image_id" readonly="1" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="1688货源研判">
                            <div class="alert alert-info" role="alert">
                                填写检索关键词后打开1688搜索页，再使用“LightLink 选品情报助手”采集当前结果。联系方式仅保存页面已公开显示的内容。
                            </div>
                            <group>
                                <group string="找货条件">
                                    <field name="sourcing_keyword" placeholder="例如：PVC 防滑条纹门垫"/>
                                    <field name="sourcing_image_url" widget="url"/>
                                    <button name="action_open_1688_search" type="object" string="打开1688关键词搜索" class="btn-primary"/>
                                    <button name="action_open_1688_image_search" type="object" string="打开1688图片搜索" class="btn-secondary"/>
                                </group>
                                <group string="利润参数">
                                    <field name="target_sale_price"/>
                                    <field name="logistics_cost"/>
                                    <field name="other_cost"/>
                                    <field name="preferred_sourcing_offer_id"/>
                                </group>
                            </group>
                            <field name="sourcing_offer_ids" context="{'default_candidate_id': id}">
                                <list editable="bottom" default_order="is_preferred desc, estimated_margin_percent desc">
                                    <field name="is_preferred" readonly="1"/>
                                    <field name="name"/>
                                    <field name="supplier_name"/>
                                    <field name="supplier_location" optional="show"/>
                                    <field name="price_text" optional="show"/>
                                    <field name="purchase_price"/>
                                    <field name="minimum_order_qty"/>
                                    <field name="sales_text" optional="show"/>
                                    <field name="contact_phone" optional="show"/>
                                    <field name="domestic_freight" optional="show"/>
                                    <field name="estimated_total_cost" readonly="1"/>
                                    <field name="estimated_profit" readonly="1"/>
                                    <field name="estimated_margin_percent" readonly="1" widget="percentage"/>
                                    <field name="product_url" widget="url" optional="show"/>
                                    <button name="action_set_preferred" type="object" string="推荐" icon="fa-star"/>
                                </list>
                            </field>
                        </page>
                        <page string="市场数据">
                            <group>
                                <group string="商业数据">
                                    <field name="supplier_price"/>
                                    <field name="target_sale_price"/>
                                    <field name="logistics_cost"/>
                                    <field name="other_cost"/>
                                    <field name="estimated_margin_percent" readonly="1"/>
                                </group>
                                <group string="市场">
                                    <field name="supplier_name"/>
                                    <field name="keyword_text"/>
                                    <field name="inquiry_count"/>
                                    <field name="transaction_count"/>
                                    <field name="heat_score"/>
                                    <field name="sales_7d"/>
                                    <field name="sales_30d"/>
                                    <field name="sales_180d"/>
                                    <field name="displayed_sales"/>
                                    <field name="sales_amount"/>
                                    <field name="price_text"/>
                                    <field name="repeat_purchase_rate"/>
                                    <field name="supplier_rating"/>
                                    <field name="review_count"/>
                                    <field name="search_rank"/>
                                    <field name="monthly_search_volume"/>
                                    <field name="trend_growth_percent"/>
                                    <field name="competitor_count"/>
                                    <field name="supplier_count"/>
                                    <field name="minimum_order_qty"/>
                                    <field name="lead_time_days"/>
                                </group>
                            </group>
                        </page>
                        <page string="评分">
                            <group>
                                <group>
                                    <field name="demand_score"/>
                                    <field name="growth_score"/>
                                    <field name="margin_score"/>
                                    <field name="competition_score"/>
                                </group>
                                <group>
                                    <field name="logistics_score"/>
                                    <field name="compliance_score"/>
                                    <field name="content_score"/>
                                </group>
                            </group>
                        </page>
                        <page string="产品简报">
                            <field name="description"/>
                        </page>
                        <page string="决策">
                            <field name="decision_notes"/>
                            <field name="rejection_reason" invisible="stage != 'rejected'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_product_intelligence_candidate_graph" model="ir.ui.view">
        <field name="name">product.intelligence.candidate.graph</field>
        <field name="model">product.intelligence.candidate</field>
        <field name="arch" type="xml">
            <graph string="机会评分" type="bar">
                <field name="stage"/>
                <field name="total_score" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_product_intelligence_candidate_pivot" model="ir.ui.view">
        <field name="name">product.intelligence.candidate.pivot</field>
        <field name="model">product.intelligence.candidate</field>
        <field name="arch" type="xml">
            <pivot string="产品机会分析">
                <field name="source_id" type="row"/>
                <field name="stage" type="col"/>
                <field name="total_score" type="measure"/>
                <field name="estimated_margin_percent" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_product_intelligence_candidate" model="ir.actions.act_window">
        <field name="name">产品机会</field>
        <field name="res_model">product.intelligence.candidate</field>
        <field name="view_mode">list,kanban,form,graph,pivot</field>
        <field name="search_view_id" ref="view_product_intelligence_candidate_search"/>
        <field name="context">{'search_default_my_candidates': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">创建第一个产品机会</p>
            <p>收集证据、评估机会，并按照 OODA 决策流程推进。</p>
        </field>
    </record>

    <record id="action_product_intelligence_research" model="ir.actions.act_window">
        <field name="name">选品情报</field>
        <field name="res_model">product.intelligence.candidate</field>
        <field name="view_mode">list,form,kanban,graph,pivot</field>
        <field name="search_view_id" ref="view_product_intelligence_candidate_search"/>
        <field name="context">{'search_default_my_candidates': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">使用浏览器采集助手推送查询结果</p>
            <p>在阿里巴巴国际站搜索页打开扩展，选择数据来源并推送当前页面。</p>
        </field>
    </record>
</odoo>
