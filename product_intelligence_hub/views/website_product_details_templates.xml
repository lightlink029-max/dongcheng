<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_product_intelligence_details"
              inherit_id="website_sale.product"
              name="网站商品选品详情"
              active="False">
        <xpath expr="//div[@id='product_full_description']" position="after">
            <section t-if="product.pi_candidate_id and (product.pi_core_industry_attributes or product.pi_important_attributes or product.pi_packaging_information or product.pi_shipping_information)"
                     class="container my-5" id="product_intelligence_details">
                <div class="border rounded-3 p-3 p-md-4 bg-light-subtle">
                    <div class="mb-4">
                        <h2 class="h3 mb-0">产品规格与交付信息</h2>
                    </div>
                    <div class="accordion" id="product_intelligence_details_accordion">
                        <div t-if="product.pi_core_industry_attributes" class="accordion-item">
                            <h3 class="accordion-header" id="pi_core_heading">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#pi_core_content" aria-expanded="true" aria-controls="pi_core_content">
                                    核心行业属性
                                </button>
                            </h3>
                            <div id="pi_core_content" class="accordion-collapse collapse show" aria-labelledby="pi_core_heading">
                                <div class="accordion-body text-break" style="white-space: pre-line;" t-field="product.pi_core_industry_attributes"/>
                            </div>
                        </div>
                        <div t-if="product.pi_important_attributes" class="accordion-item">
                            <h3 class="accordion-header" id="pi_attributes_heading">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#pi_attributes_content" aria-expanded="false" aria-controls="pi_attributes_content">
                                    详细产品属性
                                </button>
                            </h3>
                            <div id="pi_attributes_content" class="accordion-collapse collapse" aria-labelledby="pi_attributes_heading">
                                <div class="accordion-body text-break" style="white-space: pre-line;" t-field="product.pi_important_attributes"/>
                            </div>
                        </div>
                        <div t-if="product.pi_packaging_information" class="accordion-item">
                            <h3 class="accordion-header" id="pi_packaging_heading">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#pi_packaging_content" aria-expanded="false" aria-controls="pi_packaging_content">
                                    包装信息
                                </button>
                            </h3>
                            <div id="pi_packaging_content" class="accordion-collapse collapse" aria-labelledby="pi_packaging_heading">
                                <div class="accordion-body text-break" style="white-space: pre-line;" t-field="product.pi_packaging_information"/>
                            </div>
                        </div>
                        <div t-if="product.pi_shipping_information" class="accordion-item">
                            <h3 class="accordion-header" id="pi_shipping_heading">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#pi_shipping_content" aria-expanded="false" aria-controls="pi_shipping_content">
                                    发货及交货时间
                                </button>
                            </h3>
                            <div id="pi_shipping_content" class="accordion-collapse collapse" aria-labelledby="pi_shipping_heading">
                                <div class="accordion-body text-break" style="white-space: pre-line;" t-field="product.pi_shipping_information"/>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
</odoo>
