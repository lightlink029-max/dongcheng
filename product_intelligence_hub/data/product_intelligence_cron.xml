<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_product_intelligence_candidate" model="ir.sequence">
        <field name="name">Product Opportunity Candidate</field>
        <field name="code">product.intelligence.candidate</field>
        <field name="prefix">PIH/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="ir_cron_product_intelligence_sync" model="ir.cron">
        <field name="name">Product Intelligence: Synchronize Sources</field>
        <field name="model_id" ref="model_product_intelligence_source"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_sources()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">False</field>
    </record>
</odoo>

