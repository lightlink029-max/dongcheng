<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_product_intelligence" model="ir.module.category">
        <field name="name">产品智能</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_product_intelligence" model="res.groups.privilege">
        <field name="name">产品智能</field>
        <field name="sequence">35</field>
        <field name="category_id" ref="product_intelligence_hub.module_category_product_intelligence"/>
    </record>

    <record id="group_product_intelligence_user" model="res.groups">
        <field name="name">用户</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="product_intelligence_hub.privilege_product_intelligence"/>
    </record>

    <record id="group_product_intelligence_manager" model="res.groups">
        <field name="name">管理员</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="product_intelligence_hub.privilege_product_intelligence"/>
        <field name="implied_ids" eval="[(4, ref('product_intelligence_hub.group_product_intelligence_user'))]"/>
    </record>

    <record id="rule_product_intelligence_candidate_company" model="ir.rule">
        <field name="name">按公司访问产品候选项</field>
        <field name="model_id" ref="model_product_intelligence_candidate"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('product_intelligence_hub.group_product_intelligence_user'))]"/>
    </record>

    <record id="rule_product_intelligence_source_company" model="ir.rule">
        <field name="name">按公司访问产品数据来源</field>
        <field name="model_id" ref="model_product_intelligence_source"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('product_intelligence_hub.group_product_intelligence_user'))]"/>
    </record>
</odoo>
