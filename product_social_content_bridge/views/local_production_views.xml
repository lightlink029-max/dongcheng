<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_psc_local_task_list" model="ir.ui.view">
        <field name="name">psc.local.production.task.list</field>
        <field name="model">psc.local.production.task</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-danger="state == 'failed'" decoration-muted="state == 'cancelled'">
                <field name="priority" widget="handle"/>
                <field name="name"/>
                <field name="task_type"/>
                <field name="project_id"/>
                <field name="product_id"/>
                <field name="target_language"/>
                <field name="state" widget="badge"/>
                <field name="progress" widget="progressbar"/>
                <field name="worker_id"/>
                <field name="attempt_count" optional="hide"/>
                <field name="lease_expires_at" optional="hide"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>
    <record id="view_psc_local_task_form" model="ir.ui.view">
        <field name="name">psc.local.production.task.form</field>
        <field name="model">psc.local.production.task</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_retry" type="object" string="重新排队" class="btn-primary" invisible="state not in ('failed', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="取消" invisible="state not in ('queued', 'claimed', 'processing')"/>
                    <field name="state" widget="statusbar" statusbar_visible="queued,claimed,processing,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="content_id"/><field name="project_id"/><field name="product_id"/><field name="task_type"/><field name="target_language"/><field name="source_mode"/></group>
                        <group><field name="worker_id"/><field name="progress" widget="progressbar"/><field name="status_message"/><field name="attempt_count"/><field name="claimed_at"/><field name="lease_expires_at"/><field name="finished_at"/></group>
                    </group>
                    <notebook>
                        <page string="视频方案与分镜"><group><field name="video_plan_summary"/><field name="storyboard_snapshot"/></group></page>
                        <page string="输入参数"><group><field name="keywords"/><field name="source_urls"/><field name="prompt"/><field name="video_script"/><field name="aspect_ratio"/><field name="duration_seconds"/></group></page>
                        <page string="输入素材"><group><field name="source_image_attachment_id"/><field name="source_media_attachment_ids" widget="many2many_tags"/></group></page>
                        <page string="输出"><group><field name="output_attachment_id"/><field name="output_subtitle_attachment_id"/><field name="used_local_asset_ids" widget="many2many_tags"/><field name="output_manifest"/><field name="error_message"/></group></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_psc_local_tasks" model="ir.actions.act_window">
        <field name="name">本地生产任务</field><field name="res_model">psc.local.production.task</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_psc_local_tasks" name="③ 本地素材生产任务" parent="menu_psc_workflow" action="action_psc_local_tasks" sequence="30"/>

    <record id="view_psc_content_form_local_production" model="ir.ui.view">
        <field name="name">psc.content.variant.form.local.production</field>
        <field name="model">psc.content.variant</field>
        <field name="inherit_id" ref="view_psc_content_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_generate_social_image'][1]" position="attributes"><attribute name="string">提交本地图片任务</attribute></xpath>
            <xpath expr="//header/button[@name='action_generate_social_image'][2]" position="attributes"><attribute name="string">重新提交本地图片任务</attribute></xpath>
            <xpath expr="//header/button[@name='action_generate_social_video'][1]" position="attributes"><attribute name="string">提交本地视频任务</attribute></xpath>
            <xpath expr="//header/button[@name='action_generate_social_video'][2]" position="attributes"><attribute name="string">重新提交本地视频任务</attribute></xpath>
            <xpath expr="//header" position="inside"><button name="action_open_local_tasks" type="object" string="本地任务" invisible="not local_task_count"/><field name="local_task_count" invisible="1"/></xpath>
            <xpath expr="//field[@name='image_model_id']" position="attributes"><attribute name="invisible">1</attribute></xpath>
            <xpath expr="//field[@name='video_model_id']" position="attributes"><attribute name="invisible">1</attribute></xpath>
            <xpath expr="//field[@name='ai_output_tokens']/following-sibling::separator[1]" position="attributes"><attribute name="invisible">1</attribute></xpath>
            <xpath expr="//field[@name='video_script']" position="after">
                <separator string="视频整体方案与故事板"/>
                <field name="video_plan_summary" placeholder="说明面向谁、为什么制作、核心观点、叙事顺序和行动引导"/>
                <div class="o_row">
                    <field name="video_production_state" widget="badge" readonly="1"/>
                    <button name="action_lock_storyboard" type="object" string="确认并锁定故事板" class="btn-primary" invisible="storyboard_locked"/>
                    <button name="action_unlock_storyboard" type="object" string="解锁修改" class="btn-secondary" invisible="not storyboard_locked"/>
                </div>
                <field name="storyboard_locked" invisible="1"/>
                <field name="video_shot_ids" readonly="storyboard_locked">
                    <list editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="slot_key" optional="hide"/>
                        <field name="name"/>
                        <field name="purpose"/>
                        <field name="visual_requirement"/>
                        <field name="narration"/>
                        <field name="target_duration"/>
                        <field name="required"/>
                        <field name="state" widget="badge"/>
                        <field name="selected_asset_id" optional="hide"/>
                    </list>
                </field>
                <separator string="抖音人工选片"/>
                <field name="douyin_search_keyword" placeholder="默认使用当前标题或产品名称"/>
                <div class="o_row">
                    <button name="action_open_douyin_keyword_search" type="object" string="打开抖音文字搜索" class="btn-secondary"/>
                    <button name="action_open_douyin_image_search" type="object" string="打开抖音图片搜索" class="btn-secondary"/>
                </div>
                <field name="source_video_urls" placeholder="可选：手工指定的视频网址；抖音选片明细由 Windows 工具在本机管理"/>
                <field name="local_source_mode"/><field name="requested_duration"/>
            </xpath>
        </field>
    </record>

    <record id="view_psc_channel_form_local_production" model="ir.ui.view">
        <field name="name">psc.publishing.channel.form.local.production</field>
        <field name="model">psc.publishing.channel</field>
        <field name="inherit_id" ref="view_psc_channel_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='image_model_id']" position="attributes"><attribute name="invisible">1</attribute></xpath>
            <xpath expr="//field[@name='video_model_id']" position="attributes"><attribute name="invisible">1</attribute></xpath>
        </field>
    </record>

    <record id="menu_psc_media_models" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <record id="view_psc_local_media_asset_list" model="ir.ui.view">
        <field name="name">psc.local.media.asset.list</field>
        <field name="model">psc.local.media.asset</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" decoration-muted="not active">
                <field name="name"/>
                <field name="asset_kind"/>
                <field name="clip_type"/>
                <field name="business_role_id"/>
                <field name="track_id"/>
                <field name="scope_id"/>
                <field name="shot_purpose"/>
                <field name="duration"/>
                <field name="aspect_ratio"/>
                <field name="subtitle_state"/>
                <field name="copyright_status"/>
                <field name="worker_id"/>
                <field name="last_seen_at"/>
            </list>
        </field>
    </record>
    <record id="view_psc_local_media_asset_form" model="ir.ui.view">
        <field name="name">psc.local.media.asset.form</field>
        <field name="model">psc.local.media.asset</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="asset_uuid"/><field name="worker_id"/><field name="asset_kind"/><field name="clip_type"/><field name="active"/></group>
                        <group><field name="business_role_id"/><field name="track_id"/><field name="scope_id"/><field name="shot_purpose"/></group>
                    </group>
                    <group>
                        <group><field name="duration"/><field name="aspect_ratio"/><field name="language"/><field name="subtitle_state"/><field name="voice_signature"/></group>
                        <group><field name="copyright_status"/><field name="local_relative_path"/><field name="file_size"/><field name="content_hash"/><field name="last_seen_at"/></group>
                    </group>
                    <field name="metadata"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_psc_local_media_assets" model="ir.actions.act_window">
        <field name="name">本地分镜素材索引</field>
        <field name="res_model">psc.local.media.asset</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
    <menuitem id="menu_psc_local_media_assets" name="④ 本地分镜素材索引" parent="menu_psc_workflow" action="action_psc_local_media_assets" sequence="40"/>
</odoo>
