    <record id="view_psc_product_line_list" model="ir.ui.view"><field name="name">psc.product.line.list</field><field name="model">psc.product.line</field><field name="arch" type="xml"><list><field name="name"/><field name="code"/><field name="brand_name"/><field name="website_id"/><field name="tone"/><field name="active"/></list></field></record>
