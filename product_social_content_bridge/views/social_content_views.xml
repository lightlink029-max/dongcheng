    <record id="view_psc_market_list" model="ir.ui.view"><field name="name">psc.target.market.list</field><field name="model">psc.target.market</field><field name="arch" type="xml"><list><field name="name"/><field name="country_id"/><field name="lang_id"/><field name="currency_id"/><field name="customer_type"/><field name="active"/></list></field></record>
    <record id="view_psc_market_form" model="ir.ui.view"><field name="name">psc.target.market.form</field><field name="model">psc.target.market</field><field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="country_id"/><field name="lang_id"/><field name="currency_id"/><field name="customer_type"/></group><group><field name="keywords"/><field name="compliance_notes"/><field name="active"/></group></group></sheet></form></field></record>
    <record id="view_psc_channel_list" model="ir.ui.view"><field name="name">psc.publishing.channel.list</field><field name="model">psc.publishing.channel</field><field name="arch" type="xml"><list><field name="name"/><field name="platform"/><field name="social_account_ids" widget="many2many_tags"/><field name="image_ratio"/><field name="active"/></list></field></record>
    <record id="view_psc_channel_form" model="ir.ui.view"><field name="name">psc.publishing.channel.form</field><field name="model">psc.publishing.channel</field><field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="platform"/><field name="social_account_ids" widget="many2many_tags"/><field name="active"/></group><group><field name="image_ratio"/><field name="max_caption_length"/><field name="default_instructions"/></group></group></sheet></form></field></record>
    <record id="view_psc_project_list" model="ir.ui.view"><field name="name">psc.publishing.project.list</field><field name="model">psc.publishing.project</field><field name="arch" type="xml"><list default_order="create_date desc"><field name="name"/><field name="product_line_id"/><field name="market_ids" widget="many2many_tags"/><field name="channel_ids" widget="many2many_tags"/><field name="user_id"/><field name="scheduled_date"/><field name="state"/></list></field></record>
    <record id="view_psc_project_form" model="ir.ui.view"><field name="name">psc.publishing.project.form</field><field name="model">psc.publishing.project</field><field name="arch" type="xml"><form><header><button name="action_generate_drafts" type="object" string="AI生成渠道内容" class="btn-primary" invisible="state != 'draft'"/><button name="action_mark_ready" type="object" string="确认待发布" invisible="state != 'generated'"/><field name="state" widget="statusbar"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="product_line_id"/><field name="product_ids" widget="many2many_tags"/><field name="market_ids" widget="many2many_tags"/></group><group><field name="channel_ids" widget="many2many_tags"/><field name="ai_model"/><field name="user_id"/><field name="scheduled_date"/><field name="company_id" groups="base.group_multi_company"/></group></group><field name="content_brief"/><notebook><page string="渠道内容"><field name="content_ids"><list editable="bottom"><field name="product_id"/><field name="market_id"/><field name="channel_id"/><field name="language_id"/><field name="title"/><field name="ai_state"/><field name="state"/><field name="social_post_id"/><button name="action_generate_ai_content" type="object" string="重新生成"/><button name="action_create_social_post" type="object" string="创建社媒帖子" invisible="social_post_id or ai_state != 'done'"/><button name="action_open_social_post" type="object" string="打开帖子" invisible="not social_post_id"/></list></field></page></notebook></sheet><chatter/></form></field></record>
    <record id="view_psc_content_list" model="ir.ui.view"><field name="name">psc.content.variant.list</field><field name="model">psc.content.variant</field><field name="arch" type="xml"><list><field name="project_id"/><field name="product_id"/><field name="market_id"/><field name="channel_id"/><field name="language_id"/><field name="title"/><field name="state"/><field name="social_post_id"/><field name="published_url"/></list></field></record>
    <record id="view_psc_content_form" model="ir.ui.view"><field name="name">psc.content.variant.form</field><field name="model">psc.content.variant</field><field name="arch" type="xml"><form><header><button name="action_generate_ai_content" type="object" string="AI生成/重新生成"/><button name="action_create_social_post" type="object" string="创建Odoo社媒帖子" class="btn-primary" invisible="social_post_id or ai_state != 'done'"/><button name="action_open_social_post" type="object" string="打开Odoo帖子" invisible="not social_post_id"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="project_id"/><field name="product_id"/><field name="market_id"/><field name="channel_id"/><field name="language_id"/></group><group><field name="ai_state"/><field name="ai_model"/><field name="ai_generated_at"/><field name="ai_input_tokens"/><field name="ai_output_tokens"/><field name="image_attachment_id"/><field name="video_attachment_id"/><field name="social_post_id"/><field name="published_url" widget="url"/></group></group><field name="title"/><field name="caption"/><field name="hashtags"/><field name="video_script"/><field name="image_prompt"/><field name="error_message" invisible="not error_message"/></sheet></form></field></record>
    <record id="action_psc_product_line" model="ir.actions.act_window"><field name="name">品牌/产品线</field><field name="res_model">psc.product.line</field><field name="view_mode">list,form</field></record>
    <record id="action_psc_market" model="ir.actions.act_window"><field name="name">目标市场</field><field name="res_model">psc.target.market</field><field name="view_mode">list,form</field></record>
    <record id="action_psc_channel" model="ir.actions.act_window"><field name="name">发布渠道</field><field name="res_model">psc.publishing.channel</field><field name="view_mode">list,form</field></record>
    <record id="action_psc_project" model="ir.actions.act_window"><field name="name">发布项目</field><field name="res_model">psc.publishing.project</field><field name="view_mode">list,form</field></record>
    <record id="action_psc_content" model="ir.actions.act_window"><field name="name">渠道内容</field><field name="res_model">psc.content.variant</field><field name="view_mode">list,form</field></record>
