    <record id="view_psc_content_form" model="ir.ui.view"><field name="name">psc.content.variant.form</field><field name="model">psc.content.variant</field><field name="arch" type="xml"><form><header><button name="action_generate_ai_content" type="object" string="AI生成/重新生成"/><button name="action_generate_social_image" type="object" string="生成图片素材" class="btn-secondary" invisible="ai_state != 'done' or image_attachment_id"/><button name="action_generate_social_image" type="object" string="重新生成图片" class="btn-secondary" invisible="ai_state != 'done' or not image_attachment_id"/><button name="action_open_generated_image" type="object" string="查看已有图片" invisible="not image_attachment_id"/><button name="action_generate_social_video" type="object" string="生成视频素材" class="btn-secondary" invisible="ai_state != 'done' or video_attachment_id"/><button name="action_generate_social_video" type="object" string="重新生成视频" class="btn-secondary" invisible="ai_state != 'done' or not video_attachment_id"/><button name="action_open_generated_video" type="object" string="播放已有视频" invisible="not video_attachment_id"/><button name="action_create_social_post" type="object" string="创建Odoo社媒帖子" class="btn-primary" invisible="social_post_id or ai_state != 'done'"/><button name="action_open_social_post" type="object" string="打开Odoo帖子" invisible="not social_post_id"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="project_id"/><field name="product_id"/><field name="market_id"/><field name="channel_id"/><field name="language_id"/><field name="title"/><field name="caption"/><field name="hashtags"/><field name="video_script"/><field name="image_prompt"/></group><group><field name="ai_state"/><field name="ai_model"/><field name="ai_generated_at"/><field name="ai_input_tokens"/><field name="ai_output_tokens"/><separator string="本次生成模型（留空则使用渠道默认）"/><field name="image_model_id" options="{'no_create': True}"/><field name="video_model_id" options="{'no_create': True}"/><fie