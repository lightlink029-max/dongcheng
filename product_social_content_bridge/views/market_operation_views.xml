<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_psc_industry_track_list" model="ir.ui.view">
        <field name="name">psc.industry.track.list</field><field name="model">psc.industry.track</field>
        <field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="name"/><field name="code"/><field name="role_ids" widget="many2many_tags"/><field name="active"/></list></field>
    </record>
    <record id="view_psc_industry_track_form" model="ir.ui.view">
        <field name="name">psc.industry.track.form</field><field name="model">psc.industry.track</field>
        <field name="arch" type="xml">
            <form><sheet>
                <div class="oe_title"><h1><field name="name"/></h1></div>
                <group><group><field name="code"/><field name="sequence"/><field name="active"/><field name="role_ids" widget="many2many_tags"/></group><group><field name="description"/><field name="default_customer_profile"/></group></group>
                <notebook>
                    <page string="产品属性模板"><field name="product_attribute_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="code"/><field name="value_type"/><field name="unit"/><field name="required_for_publish"/><field name="hard_gate"/><field name="active"/></list></field></page>
                    <page string="评分与硬性门槛"><field name="scoring_rule_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="code"/><field name="weight"/><field name="hard_gate"/><field name="criteria"/><field name="active"/></list></field></page>
                    <page string="内容栏目"><field name="content_pillar_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="code"/><field name="role_ids" widget="many2many_tags"/><field name="objective"/><field name="default_ratio"/><field name="active"/></list></field></page>
                    <page string="客户、合规与指标"><group><field name="compliance_notes"/><field name="customer_requirement_template"/><field name="default_kpis"/></group></page>
                </notebook>
            </sheet></form>
        </field>
    </record>

    <record id="view_psc_business_role_list" model="ir.ui.view">
        <field name="name">psc.business.role.list</field><field name="model">psc.business.role</field>
        <field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="name"/><field name="code"/><field name="capability_ids" widget="many2many_tags"/><field name="active"/></list></field>
    </record>
    <record id="view_psc_business_role_form" model="ir.ui.view">
        <field name="name">psc.business.role.form</field><field name="model">psc.business.role</field>
        <field name="arch" type="xml"><form><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="code"/><field name="sequence"/><field name="active"/><field name="capability_ids" widget="many2many_tags"/></group><group><field name="description"/><field name="content_focus"/></group></group></sheet></form></field>
    </record>

    <record id="view_psc_business_capability_list" model="ir.ui.view">
        <field name="name">psc.business.capability.list</field><field name="model">psc.business.capability</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="code"/><field name="description"/><field name="active"/></list></field>
    </record>

    <record id="view_psc_content_scope_list" model="ir.ui.view">
        <field name="name">psc.content.scope.list</field><field name="model">psc.content.scope</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="code"/><field name="default_video_ratio"/><field name="description"/><field name="active"/></list></field>
    </record>
    <record id="view_psc_content_scope_form" model="ir.ui.view">
        <field name="name">psc.content.scope.form</field><field name="model">psc.content.scope</field>
        <field name="arch" type="xml"><form><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="code"/><field name="sequence"/><field name="default_video_ratio"/><field name="active"/></group><group><field name="description" placeholder="说明该内容类型适合表达什么，以及必须使用哪些真实依据。"/></group></group></sheet></form></field>
    </record>
    <record id="view_psc_media_tag_list" model="ir.ui.view">
        <field name="name">psc.media.tag.list</field><field name="model">psc.media.tag</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="name"/><field name="color" widget="color_picker"/><field name="active"/></list></field>
    </record>
    <record id="view_psc_content_mix_rule_list" model="ir.ui.view">
        <field name="name">psc.content.mix.rule.list</field><field name="model">psc.content.mix.rule</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="track_id"/><field name="role_id"/><field name="scope_id"/><field name="content_ratio" sum="合计"/><field name="video_ratio"/><field name="notes" optional="hide"/><field name="active"/></list></field>
    </record>
    <record id="view_psc_content_mix_rule_search" model="ir.ui.view">
        <field name="name">psc.content.mix.rule.search</field><field name="model">psc.content.mix.rule</field>
        <field name="arch" type="xml"><search><field name="track_id"/><field name="role_id"/><field name="scope_id"/><group><filter name="group_track" string="经营赛道" context="{'group_by': 'track_id'}"/><filter name="group_role" string="经营角色" context="{'group_by': 'role_id'}"/></group></search></field>
    </record>

    <record id="view_psc_project_product_list" model="ir.ui.view">
        <field name="name">psc.project.product.list</field><field name="model">psc.project.product</field>
        <field name="arch" type="xml"><list decoration-success="status == 'active'" decoration-danger="status == 'rejected' or compliance_state == 'blocked'" decoration-warning="status in ('candidate', 'quotation', 'market_review', 'compliance_review')"><field name="priority" widget="badge"/><field name="name"/><field name="source"/><field name="market_ids" widget="many2many_tags"/><field name="fit_score"/><field name="hard_gate_passed"/><field name="compliance_state" widget="badge"/><field name="material_state" widget="badge"/><field name="target_purchase_price"/><field name="target_sale_price"/><field name="minimum_order_qty"/><field name="lead_time_days"/><field name="status" widget="badge"/><button name="action_open_source" type="object" string="打开产品" icon="fa-external-link"/><button name="action_link_candidate_product" type="object" string="转正式产品" icon="fa-link" invisible="not candidate_id or product_id"/><button name="action_mark_active" type="object" string="批准运营" icon="fa-check" invisible="status == 'active'"/></list></field>
    </record>
    <record id="view_psc_project_product_form" model="ir.ui.view">
        <field name="name">psc.project.product.form</field><field name="model">psc.project.product</field>
        <field name="arch" type="xml"><form><header><button name="action_link_candidate_product" type="object" string="转为正式产品" class="btn-secondary" invisible="not candidate_id or product_id"/><button name="action_mark_active" type="object" string="批准进入运营" class="btn-primary" invisible="status == 'active'"/><field name="status" widget="statusbar" statusbar_visible="candidate,quotation,market_review,compliance_review,active"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="project_id"/><field name="source"/><field name="product_id"/><field name="candidate_id"/><field name="market_ids" widget="many2many_tags"/><field name="priority"/></group><group><field name="fit_score"/><field name="hard_gate_passed"/><field name="compliance_state"/><field name="material_state"/><field name="last_reviewed_at"/><field name="next_review_date"/></group></group><group string="价格与供应"><field name="target_purchase_price"/><field name="target_sale_price"/><field name="minimum_order_qty"/><field name="lead_time_days"/></group><group string="项目判断"><field name="positioning"/><field name="selling_points"/><field name="recommendation"/></group><notebook><page string="赛道产品属性"><field name="attribute_value_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="attribute_id"/><field name="name"/><field name="value"/><field name="required_for_publish"/><field name="hard_gate"/><field name="verified"/><field name="evidence"/></list></field></page><page string="市场适配评分"><field name="score_line_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="rule_id"/><field name="name"/><field name="weight"/><field name="score"/><field name="hard_gate"/><field name="gate_passed"/><field name="notes"/></list></field></page></notebook></sheet></form></field>
    </record>

    <record id="view_psc_content_plan_list" model="ir.ui.view">
        <field name="name">psc.content.plan.list</field><field name="model">psc.content.plan</field>
        <field name="arch" type="xml"><list decoration-success="state == 'published'" decoration-muted="state == 'cancelled'"><field name="scheduled_at"/><field name="scope_id"/><field name="content_format" widget="badge"/><field name="name"/><field name="objective" optional="show"/><field name="product_ids" widget="many2many_tags" optional="hide"/><field name="market_ids" widget="many2many_tags" optional="show"/><field name="channel_ids" widget="many2many_tags" optional="show"/><field name="cluster_ids" widget="many2many_tags" optional="show"/><field name="content_count"/><field name="state" widget="badge"/><button name="action_prepare_content" type="object" string="生成渠道版本" icon="fa-file-text-o" invisible="content_count"/><button name="action_open_content" type="object" string="打开内容" icon="fa-external-link" invisible="not content_count"/></list></field>
    </record>
    <record id="view_psc_content_plan_form" model="ir.ui.view">
        <field name="name">psc.content.plan.form</field><field name="model">psc.content.plan</field>
        <field name="arch" type="xml"><form><header><button name="action_prepare_content" type="object" string="生成渠道内容" class="btn-primary" invisible="content_count"/><button name="action_open_content" type="object" string="打开渠道内容" invisible="not content_count"/><field name="state" widget="statusbar" statusbar_visible="draft,prepared,ready,published"/></header><sheet><div class="oe_title"><h1><field name="name" placeholder="例如：为什么欧洲鞋类批发商需要中国采购代理"/></h1></div><group><group><field name="project_id"/><field name="scope_id" required="1" options="{'no_create': True}"/><field name="content_format"/><field name="objective"/><field name="scheduled_at"/></group><group><field name="market_ids" widget="many2many_tags"/><field name="channel_ids" widget="many2many_tags"/><field name="cluster_ids" widget="many2many_tags"/><field name="product_ids" widget="many2many_tags"/><field name="tag_ids" widget="many2many_tags"/></group></group><group string="创作要求"><field name="brief" nolabel="1" colspan="2" placeholder="填写核心观点、证据、结构、行动号召和禁用表达。产品内容必须关联真实产品。"/></group><notebook><page string="渠道版本"><field name="content_ids" nolabel="1" readonly="1"><list><field name="market_id"/><field name="channel_id"/><field name="title"/><field name="ai_state" widget="badge"/><field name="state" widget="badge"/><field name="video_attachment_id" optional="hide"/></list></field></page><page string="兼容旧数据"><group><field name="pillar_id"/><field name="product_id"/><field name="market_id"/><field name="channel_id"/><field name="content_id"/></group></page></notebook></sheet></form></field>
    </record>

    <record id="view_psc_social_account_cluster_list" model="ir.ui.view">
        <field name="name">psc.social.account.cluster.list</field><field name="model">psc.social.account.cluster</field>
        <field name="arch" type="xml"><list decoration-success="state == 'ready'" decoration-danger="state == 'failed'" decoration-muted="state == 'paused'"><field name="name"/><field name="track_id"/><field name="persona"/><field name="target_market_id"/><field name="worker_node_id"/><field name="bitbrowser_environment_id"/><field name="expected_ip"/><field name="expected_country_id"/><field name="expected_timezone"/><field name="state" widget="badge"/><field name="active"/></list></field>
    </record>
    <record id="view_psc_social_account_cluster_form" model="ir.ui.view">
        <field name="name">psc.social.account.cluster.form</field><field name="model">psc.social.account.cluster</field>
        <field name="arch" type="xml"><form><header><button name="action_mark_ready" type="object" string="确认集群可用" class="btn-primary" invisible="state == 'ready'"/><button name="action_pause" type="object" string="暂停" invisible="state == 'paused'"/><field name="state" widget="statusbar" statusbar_visible="draft,ready,busy,failed,paused"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group string="经营定位"><field name="track_id"/><field name="product_line_id"/><field name="project_ids" widget="many2many_tags"/><field name="target_market_id"/><field name="persona"/><field name="positioning"/><field name="active"/></group><group string="比特环境与固定 IP"><field name="worker_node_id"/><field name="bitbrowser_environment_id" options="{'no_create': True}"/><field name="expected_ip"/><field name="expected_country_id"/><field name="expected_timezone"/><field name="last_validation_at"/><field name="last_validation_message"/></group></group><group string="平台账号"><field name="account_ids" context="{'default_cluster_id': id}"><list editable="bottom" decoration-success="account_state == 'available'" decoration-danger="account_state in ('unavailable', 'replacement_pending')"><field name="channel_id"/><field name="name"/><field name="username"/><field name="profile_url"/><field name="daily_publish_limit"/><field name="last_validation_state" widget="badge"/><field name="account_state" widget="badge"/></list></field></group></sheet></form></field>
    </record>

    <record id="view_psc_customer_touchpoint_list" model="ir.ui.view">
        <field name="name">psc.customer.touchpoint.list</field><field name="model">psc.customer.touchpoint</field>
        <field name="arch" type="xml"><list><field name="occurred_at"/><field name="lead_id"/><field name="event_type" widget="badge"/><field name="source_type" widget="badge"/><field name="project_id"/><field name="cluster_id"/><field name="account_id"/><field name="content_id"/><field name="product_id"/><field name="verified"/></list></field>
    </record>
    <record id="view_psc_customer_requirement_list" model="ir.ui.view">
        <field name="name">psc.customer.requirement.list</field><field name="model">psc.customer.requirement</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="lead_id"/><field name="project_id"/><field name="track_id"/><field name="organization_type"/><field name="quantity"/><field name="budget"/><field name="target_purchase_date"/><field name="stage" widget="badge"/></list></field>
    </record>

    <record id="view_psc_performance_snapshot_list" model="ir.ui.view">
        <field name="name">psc.performance.snapshot.list</field><field name="model">psc.performance.snapshot</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="snapshot_date"/><field name="project_id"/><field name="destination_id"/><field name="cluster_id"/><field name="account_id"/><field name="content_id"/><field name="product_id"/><field name="impressions"/><field name="views"/><field name="clicks"/><field name="inquiries"/><field name="qualified_leads"/><field name="quotations"/><field name="orders"/><field name="revenue"/><field name="purchase_cost"/><field name="traffic_cost"/></list></field>
    </record>
    <record id="view_psc_optimization_action_list" model="ir.ui.view">
        <field name="name">psc.optimization.action.list</field><field name="model">psc.optimization.action</field>
        <field name="arch" type="xml"><list decoration-success="state == 'done'" decoration-warning="state in ('approved', 'doing')"><field name="priority" widget="badge"/><field name="name"/><field name="project_id"/><field name="category"/><field name="owner_id"/><field name="due_date"/><field name="state" widget="badge"/><button name="action_approve" type="object" string="批准" invisible="state != 'draft'"/><button name="action_start" type="object" string="开始" invisible="state != 'approved'"/><button name="action_done" type="object" string="完成" invisible="state != 'doing'"/></list></field>
    </record>

    <record id="view_psc_project_readiness_item_search" model="ir.ui.view">
        <field name="name">psc.project.readiness.item.search</field>
        <field name="model">psc.project.readiness.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="project_id"/><field name="owner_id"/>
                <filter name="today" string="今日" domain="[('due_date', '=', context_today())]"/>
                <filter name="overdue" string="已逾期" domain="[('due_date', '&lt;', context_today()), ('state', '!=', 'done')]"/>
                <filter name="blocked" string="阻塞" domain="[('state', '=', 'blocked')]"/>
                <filter name="my_work" string="我的任务" domain="[('owner_id', '=', uid)]"/>
                <group>
                    <filter name="group_project" string="项目" context="{'group_by': 'project_id'}"/>
                    <filter name="group_category" string="阶段" context="{'group_by': 'category'}"/>
                    <filter name="group_responsibility" string="责任归属" context="{'group_by': 'responsibility'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_psc_project_readiness_item_list" model="ir.ui.view">
        <field name="name">psc.project.readiness.item.list</field>
        <field name="model">psc.project.readiness.item</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-danger="state == 'blocked'" decoration-warning="state == 'doing'">
                <field name="sequence" widget="handle"/><field name="due_date"/><field name="category"/>
                <field name="name"/><field name="weight" sum="100"/><field name="hard_gate"/>
                <field name="responsibility" widget="badge"/><field name="owner_id"/><field name="state" widget="badge"/>
                <button name="action_start" type="object" string="开始" invisible="state not in ('todo', 'blocked')"/>
                <button name="action_block" type="object" string="阻塞" invisible="state == 'done'"/>
                <button name="action_done" type="object" string="完成" invisible="state == 'done'"/>
                <button name="action_reopen" type="object" string="重开" invisible="state != 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_psc_project_readiness_item_form" model="ir.ui.view">
        <field name="name">psc.project.readiness.item.form</field>
        <field name="model">psc.project.readiness.item</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="开始" class="btn-secondary" invisible="state not in ('todo', 'blocked')"/>
                    <button name="action_block" type="object" string="标记阻塞" class="btn-secondary" invisible="state == 'done'"/>
                    <button name="action_done" type="object" string="完成" class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_reopen" type="object" string="重新打开" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="todo,doing,blocked,done" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="project_id"/><field name="category"/><field name="responsibility"/><field name="owner_id"/></group>
                        <group><field name="due_date"/><field name="weight"/><field name="hard_gate"/><field name="completed_at"/></group>
                    </group>
                    <group string="完成标准"><field name="description"/></group>
                    <group string="完成依据"><field name="evidence" placeholder="填写真实文件、页面、记录或测试结果；硬门槛完成前必须填写。"/></group>
                    <group string="阻塞说明"><field name="block_reason" placeholder="标记阻塞前先填写具体原因和需要谁处理。"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_psc_project_readiness_items" model="ir.actions.act_window">
        <field name="name">今日上线准备</field>
        <field name="res_model">psc.project.readiness.item</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_psc_project_readiness_item_search"/>
        <field name="context">{'search_default_today': 1, 'search_default_my_work': 1}</field>
    </record>

    <record id="view_psc_project_form_market_operations" model="ir.ui.view">
        <field name="name">psc.publishing.project.form.market.operations</field>
        <field name="model">psc.publishing.project</field>
        <field name="inherit_id" ref="view_psc_project_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_activate_operation" type="object" string="启动长期运营" class="btn-secondary" invisible="operation_state == 'active'"/>
                <button name="action_sync_product_pool" type="object" string="同步所选产品到产品池" invisible="not product_ids"/>
                <field name="operation_state" widget="badge"/>
            </xpath>
            <xpath expr="//button[@name='action_generate_drafts']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='product_line_id']" position="before">
                <field name="track_id" required="1" options="{'no_create': True}"/>
                <field name="business_role_id" required="1" options="{'no_create': True}"/>
                <field name="capability_ids" widget="many2many_tags"/>
            </xpath>
            <xpath expr="//field[@name='product_ids']" position="attributes">
                <attribute name="string">从 Odoo 产品库快速选择</attribute>
                <attribute name="required">0</attribute>
            </xpath>
            <xpath expr="//field[@name='product_ids']" position="after"><field name="business_goal" placeholder="填写长期经营目标、客户类型、产品方向和阶段性目标。"/></xpath>
            <xpath expr="//sheet/notebook/page[1]" position="before">
                <page string="上线准备" name="launch_readiness">
                    <div class="alert alert-info" role="alert">只有进度达到 100%、全部硬门槛有真实依据且首发产品通过审核后，项目才能启动运营或创建发布任务。</div>
                    <group string="上线状态" col="6" colspan="2">
                        <field name="readiness_progress" widget="progressbar" options="{'max_value': 100}" readonly="1"/>
                        <field name="readiness_done_count" readonly="1"/>
                        <field name="readiness_total_count" readonly="1"/>
                        <field name="readiness_blocked_count" readonly="1"/>
                        <field name="readiness_overdue_count" readonly="1"/>
                        <field name="launch_ready" readonly="1"/>
                    </group>
                    <field name="readiness_blocker_summary" nolabel="1" colspan="2" readonly="1" invisible="not readiness_blocker_summary"/>
                    <div class="d-flex justify-content-end mb-2" colspan="2">
                        <button name="action_open_readiness_items" type="object" string="查看完整准备清单" icon="fa-list" class="btn-secondary"/>
                    </div>
                    <field name="readiness_item_ids" nolabel="1" colspan="2" class="w-100" context="{'default_project_id': id}" mode="list,form">
                        <list limit="8" create="false" delete="false" decoration-success="state == 'done'" decoration-danger="state == 'blocked'" decoration-warning="state == 'doing'">
                            <field name="name"/>
                            <field name="responsibility" widget="badge"/>
                            <field name="due_date"/>
                            <field name="state" widget="badge"/>
                            <button name="action_start" type="object" string="开始" invisible="state not in ('todo', 'blocked')"/>
                            <button name="action_done" type="object" string="完成" invisible="state == 'done'"/>
                        </list>
                    </field>
                </page>
                <page string="项目产品池">
                    <div class="alert alert-info" role="alert">正式产品可从 Odoo 产品库选择后同步；产品智能候选必须先审核批准，才能转为正式产品并进入运营。</div>
                    <field name="project_product_ids" context="{'default_project_id': id}">
                        <list decoration-success="status == 'active'" decoration-danger="status == 'rejected' or compliance_state == 'blocked'" decoration-warning="status in ('candidate', 'quotation', 'market_review', 'compliance_review')">
                            <field name="priority" widget="badge"/><field name="name"/><field name="source"/><field name="product_id"/><field name="candidate_id"/><field name="market_ids" widget="many2many_tags"/><field name="fit_score"/><field name="hard_gate_passed"/><field name="compliance_state" widget="badge"/><field name="material_state" widget="badge"/><field name="status" widget="badge"/><button name="action_open_source" type="object" string="打开" icon="fa-external-link"/><button name="action_link_candidate_product" type="object" string="转正式产品" invisible="not candidate_id or product_id"/><button name="action_mark_active" type="object" string="批准运营" invisible="status == 'active'"/>
                        </list>
                    </field>
                </page>
                <page string="统一社媒内容工作台" name="social_content_workspace">
                    <div class="alert alert-info" role="alert">先按项目定位、经营角色和内容类型制定任务，再复用到目标市场、渠道和账号集群。只有“产品或品类介绍”必须关联真实产品。</div>
                    <separator string="内容策略与素材库" colspan="2"/>
                    <field name="content_brief" nolabel="1" colspan="2" placeholder="项目级英文定位、受众、价值主张、事实边界和统一行动号召。"/>
                    <field name="material_asset_ids" nolabel="1" colspan="2" class="w-100">
                        <list><field name="sequence" widget="handle"/><field name="name"/><field name="asset_type" widget="badge"/><field name="content_scope_ids" widget="many2many_tags"/><field name="tag_ids" widget="many2many_tags"/><field name="file_name"/><field name="channel_id" optional="hide"/><field name="active"/></list>
                    </field>
                    <div class="d-flex flex-wrap gap-2 align-items-center mt-2 mb-2" colspan="2">
                        <button name="action_open_content_mix_rules" type="object" string="维护建议内容与视频比例" icon="fa-sliders" class="btn-secondary"/>
                        <button name="action_open_video_content_share" type="object" string="查看实际发布占比" icon="fa-pie-chart" class="btn-secondary"/>
                    </div>
                    <field name="content_mix_rule_ids" nolabel="1" colspan="2" class="w-100" readonly="1">
                        <list create="false" delete="false" limit="10"><field name="scope_id"/><field name="content_ratio" sum="合计"/><field name="video_ratio"/><field name="notes" optional="hide"/></list>
                    </field>
                    <separator string="账号集群" colspan="2"/>
                    <div class="text-muted mb-2" colspan="2">选择本项目可用的账号集群；内容任务可以进一步指定发布到哪些集群。</div>
                    <field name="account_cluster_ids" nolabel="1" colspan="2" class="w-100" widget="many2many" options="{'no_create': True}">
                        <list><field name="name"/><field name="persona"/><field name="target_market_id"/><field name="state" widget="badge"/></list>
                    </field>
                    <separator string="内容制作计划" colspan="2"/>
                    <field name="content_plan_ids" nolabel="1" colspan="2" class="w-100" context="{'default_project_id': id}">
                        <list editable="bottom" decoration-success="state == 'published'"><field name="scheduled_at"/><field name="scope_id" required="1"/><field name="content_format" widget="badge"/><field name="name"/><field name="objective" optional="show"/><field name="product_ids" widget="many2many_tags" optional="hide"/><field name="market_ids" widget="many2many_tags" optional="show"/><field name="channel_ids" widget="many2many_tags" optional="show"/><field name="cluster_ids" widget="many2many_tags" optional="show"/><field name="tag_ids" widget="many2many_tags" optional="hide"/><field name="content_count"/><field name="state" widget="badge"/><button name="action_prepare_content" type="object" string="生成渠道版本" invisible="content_count"/><button name="action_open_content" type="object" string="打开内容" invisible="not content_count"/></list>
                    </field>
                    <separator string="渠道内容制作" colspan="2"/>
                    <field name="content_ids" nolabel="1" colspan="2" class="w-100" readonly="1">
                        <list><field name="scope_id"/><field name="content_format" widget="badge"/><field name="market_id"/><field name="channel_id"/><field name="title"/><field name="material_asset_ids" widget="many2many_tags" optional="show"/><field name="tag_ids" widget="many2many_tags" optional="hide"/><field name="ai_state" widget="badge"/><field name="state" widget="badge"/><field name="video_attachment_id" optional="hide"/><button name="action_generate_ai_content" type="object" string="生成文案" icon="fa-magic"/><button name="action_open_generated_video" type="object" string="播放视频" icon="fa-play" invisible="not video_attachment_id"/></list>
                    </field>
                    <separator string="发布任务与实际占比依据" colspan="2"/>
                    <field name="publication_task_ids" nolabel="1" colspan="2" class="w-100" readonly="1">
                        <list decoration-success="state == 'published'" decoration-danger="state == 'failed'"><field name="scheduled_at"/><field name="content_scope_id"/><field name="content_format" widget="badge"/><field name="cluster_id"/><field name="destination_id"/><field name="state" widget="badge"/><field name="published_url" widget="url" optional="show"/><field name="status_message" optional="hide"/></list>
                    </field>
                </page>
                <page string="客户与需求">
                    <field name="lead_ids" context="{'default_psc_project_id': id}"><list><field name="name"/><field name="partner_name"/><field name="country_id"/><field name="user_id"/><field name="psc_first_touchpoint_id"/><field name="psc_last_touchpoint_id"/><field name="stage_id"/><field name="expected_revenue"/></list></field>
                </page>
                <page string="数据与优化">
                    <group string="渠道、产品和成交数据"><field name="performance_snapshot_ids"><list editable="bottom"><field name="snapshot_date"/><field name="destination_id"/><field name="cluster_id"/><field name="account_id"/><field name="content_id"/><field name="product_id"/><field name="impressions"/><field name="clicks"/><field name="inquiries"/><field name="qualified_leads"/><field name="quotations"/><field name="orders"/><field name="revenue"/><field name="purchase_cost"/></list></field></group>
                    <group string="基于数据的优化任务"><field name="optimization_action_ids"><list editable="bottom" decoration-success="state == 'done'"><field name="priority" widget="badge"/><field name="name"/><field name="category"/><field name="evidence"/><field name="proposed_action"/><field name="owner_id"/><field name="due_date"/><field name="state" widget="badge"/><button name="action_approve" type="object" string="批准" invisible="state != 'draft'"/><button name="action_start" type="object" string="开始" invisible="state != 'approved'"/><button name="action_done" type="object" string="完成" invisible="state != 'doing'"/></list></field></group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_psc_content_form_market_operations" model="ir.ui.view">
        <field name="name">psc.content.variant.form.market.operations</field><field name="model">psc.content.variant</field><field name="inherit_id" ref="view_psc_content_form"/>
        <field name="arch" type="xml"><xpath expr="//field[@name='project_id']" position="after"><field name="plan_id"/><field name="pillar_id"/></xpath></field>
    </record>

    <record id="view_product_intelligence_candidate_market_fit" model="ir.ui.view">
        <field name="name">product.intelligence.candidate.form.market.fit</field>
        <field name="model">product.intelligence.candidate</field>
        <field name="inherit_id" ref="product_intelligence_hub.view_product_intelligence_candidate_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="适合赛道与市场">
                    <div class="alert alert-info" role="alert">产品采集后按赛道和目标市场记录需求依据、适合客户、合规判断和推荐结论；人工确认后再加入项目产品池。</div>
                    <field name="psc_market_fit_ids">
                        <list editable="bottom" decoration-success="state == 'approved'" decoration-danger="state == 'rejected' or compliance_state == 'blocked'">
                            <field name="track_id"/><field name="market_id"/><field name="business_role_id"/><field name="fit_score"/><field name="demand_evidence"/><field name="target_customer"/><field name="compliance_state" widget="badge"/><field name="state" widget="badge"/><field name="recommendation"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_psc_social_account_form_cluster" model="ir.ui.view">
        <field name="name">psc.social.publishing.account.form.cluster</field><field name="model">psc.social.publishing.account</field><field name="inherit_id" ref="view_psc_social_publishing_account_form"/>
        <field name="arch" type="xml"><xpath expr="//field[@name='product_line_id']" position="before"><field name="cluster_id" options="{'no_create': True}"/></xpath></field>
    </record>
    <record id="view_psc_social_account_list_cluster" model="ir.ui.view">
        <field name="name">psc.social.publishing.account.list.cluster</field><field name="model">psc.social.publishing.account</field><field name="inherit_id" ref="view_psc_social_publishing_account_list"/>
        <field name="arch" type="xml"><xpath expr="//field[@name='name']" position="after"><field name="cluster_id" optional="show"/></xpath></field>
    </record>

    <record id="view_psc_registration_task_form_cluster" model="ir.ui.view">
        <field name="name">psc.social.registration.task.form.cluster</field><field name="model">psc.social.registration.task</field><field name="inherit_id" ref="view_psc_social_registration_task_form"/>
        <field name="arch" type="xml"><xpath expr="//field[@name='slot_id']" position="before"><field name="cluster_id" options="{'no_create': True}"/></xpath></field>
    </record>
    <record id="view_psc_registration_task_list_cluster" model="ir.ui.view">
        <field name="name">psc.social.registration.task.list.cluster</field><field name="model">psc.social.registration.task</field><field name="inherit_id" ref="view_psc_social_registration_task_list"/>
        <field name="arch" type="xml"><xpath expr="//field[@name='task_mode']" position="after"><field name="cluster_id" optional="show"/></xpath></field>
    </record>

    <record id="view_crm_lead_form_market_operations" model="ir.ui.view">
        <field name="name">crm.lead.form.market.operations</field><field name="model">crm.lead</field><field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="客户来源与行业需求" name="psc_customer_journey"><group><field name="psc_first_touchpoint_id"/><field name="psc_last_touchpoint_id"/></group><group string="完整客户触点"><field name="psc_touchpoint_ids"><list editable="bottom"><field name="occurred_at"/><field name="event_type"/><field name="source_type"/><field name="project_id"/><field name="cluster_id"/><field name="account_id"/><field name="content_id"/><field name="product_id"/><field name="verified"/></list></field></group><group string="行业采购需求"><field name="psc_requirement_ids"><list editable="bottom"><field name="name"/><field name="project_id"/><field name="track_id"/><field name="organization_type"/><field name="quantity"/><field name="budget"/><field name="target_purchase_date"/><field name="stage"/></list></field></group></page></xpath></field>
    </record>

    <record id="action_psc_industry_tracks" model="ir.actions.act_window"><field name="name">经营赛道模板</field><field name="res_model">psc.industry.track</field><field name="view_mode">list,form</field></record>
    <record id="action_psc_business_roles" model="ir.actions.act_window"><field name="name">经营角色</field><field name="res_model">psc.business.role</field><field name="view_mode">list,form</field></record>
    <record id="action_psc_business_capabilities" model="ir.actions.act_window"><field name="name">经营能力</field><field name="res_model">psc.business.capability</field><field name="view_mode">list</field></record>
    <record id="action_psc_content_scopes" model="ir.actions.act_window"><field name="name">社媒内容类型</field><field name="res_model">psc.content.scope</field><field name="view_mode">list,form</field></record>
    <record id="action_psc_media_tags" model="ir.actions.act_window"><field name="name">社媒素材标签</field><field name="res_model">psc.media.tag</field><field name="view_mode">list,form</field></record>
    <record id="action_psc_content_mix_rules" model="ir.actions.act_window"><field name="name">内容与视频比例</field><field name="res_model">psc.content.mix.rule</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_psc_content_mix_rule_search"/></record>
    <record id="action_psc_project_products" model="ir.actions.act_window"><field name="name">项目产品池</field><field name="res_model">psc.project.product</field><field name="view_mode">list,form</field></record>
    <record id="action_psc_content_plans" model="ir.actions.act_window"><field name="name">统一社媒内容工作台</field><field name="res_model">psc.content.plan</field><field name="view_mode">list,form</field></record>
    <record id="action_psc_social_account_clusters" model="ir.actions.act_window"><field name="name">账号集群</field><field name="res_model">psc.social.account.cluster</field><field name="view_mode">list,form</field></record>
    <record id="action_psc_customer_touchpoints" model="ir.actions.act_window"><field name="name">客户来源触点</field><field name="res_model">psc.customer.touchpoint</field><field name="view_mode">list,form</field></record>
    <record id="action_psc_customer_requirements" model="ir.actions.act_window"><field name="name">客户行业需求</field><field name="res_model">psc.customer.requirement</field><field name="view_mode">list,form</field></record>
    <record id="action_psc_performance_snapshots" model="ir.actions.act_window"><field name="name">经营数据</field><field name="res_model">psc.performance.snapshot</field><field name="view_mode">list</field></record>
    <record id="action_psc_optimization_actions" model="ir.actions.act_window"><field name="name">优化任务</field><field name="res_model">psc.optimization.action</field><field name="view_mode">list,form</field></record>
</odoo>
