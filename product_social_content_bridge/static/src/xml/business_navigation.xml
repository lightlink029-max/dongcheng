<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="product_social_content_bridge.BusinessNavigation">
        <section class="o_psc_business_navigation" aria-label="左侧导航管理">
            <div class="o_psc_nav_header">
                <div>
                    <h2>左侧导航管理</h2>
                    <p>这里与页面左侧导航完全一致；拖动入口调整分类或顺序后，左侧立即同步。</p>
                </div>
                <div class="o_psc_nav_actions" t-if="state.canEdit">
                    <span class="o_psc_nav_status" t-if="state.status"><t t-esc="state.status"/></span>
                    <button type="button" class="btn btn-secondary" t-on-click="resetLayout" t-att-disabled="state.saving">
                        <i class="fa fa-undo me-1"/>恢复默认
                    </button>
                    <button type="button" t-att-class="state.editMode ? 'btn btn-primary' : 'btn btn-secondary'" t-on-click="toggleEditMode" t-att-disabled="state.saving">
                        <i t-att-class="state.editMode ? 'fa fa-check me-1' : 'fa fa-arrows me-1'"/>
                        <t t-esc="state.editMode ? '完成整理' : '整理模式'"/>
                    </button>
                </div>
            </div>

            <div class="o_psc_nav_loading" t-if="state.loading">
                <i class="fa fa-spinner fa-spin me-2"/>正在加载功能导航…
            </div>

            <div class="o_psc_nav_sections" t-else="">
                <section
                    t-foreach="state.categories"
                    t-as="category"
                    t-key="category.code"
                    t-att-class="state.editMode ? 'o_psc_nav_section is-editing' : 'o_psc_nav_section'"
                    t-att-data-category="category.code"
                    t-on-dragover="allowDrop"
                    t-on-drop="dropAtEnd"
                >
                    <header>
                        <h3><i t-att-class="'fa ' + category.icon + ' me-2'"/><t t-esc="category.name"/></h3>
                        <span><t t-esc="category.items.length"/> 项</span>
                    </header>
                    <div class="o_psc_nav_items">
                        <button
                            t-foreach="category.items"
                            t-as="item"
                            t-key="item.id"
                            type="button"
                            t-att-class="state.draggedMenuId === item.id ? 'o_psc_nav_item is-dragging' : 'o_psc_nav_item'"
                            t-att-draggable="isDraggable(item)"
                            t-att-data-menu-id="item.id"
                            t-att-data-category="category.code"
                            t-att-data-before-id="item.id"
                            t-on-click="() => this.openMenu(item)"
                            t-on-dragstart="onDragStart"
                            t-on-dragend="onDragEnd"
                            t-on-dragover="allowDrop"
                            t-on-drop="dropBefore"
                        >
                            <span class="o_psc_nav_item_icon">
                                <img t-if="getMenuIcon(item)" t-att-src="getMenuIcon(item)" t-att-alt="item.name"/>
                                <i t-else="" t-att-class="'fa ' + item.fallback_icon"/>
                            </span>
                            <span class="o_psc_nav_item_name"><t t-esc="item.name"/></span>
                            <i t-if="state.editMode &amp;&amp; !item.locked" class="fa fa-arrows o_psc_nav_drag_hint" aria-label="可拖动"/>
                            <i t-if="item.locked" class="fa fa-lock o_psc_nav_drag_hint" aria-label="固定入口"/>
                        </button>
                        <div class="o_psc_nav_empty" t-if="!category.items.length">
                            <i class="fa fa-inbox me-2"/>暂无功能，可把图标拖到这里。
                        </div>
                    </div>
                </section>
            </div>
        </section>
    </t>

    <t t-name="product_social_content_bridge.BusinessSidebar">
        <aside
            t-if="!state.fullscreen"
            t-att-class="state.collapsed ? 'o_psc_business_sidebar is-collapsed d-none d-lg-flex' : 'o_psc_business_sidebar d-none d-lg-flex'"
            aria-label="LightLink 工作导航"
        >
            <header class="o_psc_sidebar_header">
                <span class="o_psc_sidebar_brand">
                    <i class="fa fa-compass"/>
                    <span class="o_psc_sidebar_label">LightLink 工作导航</span>
                </span>
                <button
                    type="button"
                    class="o_psc_sidebar_collapse"
                    t-att-title="state.collapsed ? '展开左侧导航' : '收起左侧导航'"
                    t-att-aria-label="state.collapsed ? '展开左侧导航' : '收起左侧导航'"
                    t-on-click="toggleCollapsed"
                >
                    <i t-att-class="state.collapsed ? 'fa fa-angle-double-right' : 'fa fa-angle-double-left'"/>
                </button>
            </header>

            <button
                type="button"
                class="o_psc_sidebar_back"
                title="返回上一级"
                aria-label="返回上一级"
                t-att-disabled="!state.canGoBack"
                t-on-click="goBack"
            >
                <i class="fa fa-arrow-left"/>
                <span class="o_psc_sidebar_label">返回上一级</span>
            </button>

            <div class="o_psc_sidebar_loading" t-if="state.loading">
                <i class="fa fa-spinner fa-spin"/>
                <span class="o_psc_sidebar_label">正在加载…</span>
            </div>

            <nav class="o_psc_sidebar_groups" t-else="" aria-label="业务功能">
                <section
                    t-foreach="state.categories"
                    t-as="category"
                    t-key="category.code"
                    t-att-class="state.openCategory === category.code ? 'o_psc_sidebar_group is-open' : 'o_psc_sidebar_group'"
                >
                    <button
                        type="button"
                        class="o_psc_sidebar_group_button"
                        t-att-title="category.name"
                        t-att-aria-expanded="state.openCategory === category.code"
                        t-on-click="() => this.toggleCategory(category)"
                    >
                        <span class="o_psc_sidebar_group_icon"><i t-att-class="'fa ' + category.icon"/></span>
                        <span class="o_psc_sidebar_label"><t t-esc="category.name"/></span>
                        <i class="fa fa-angle-down o_psc_sidebar_chevron"/>
                    </button>
                    <div class="o_psc_sidebar_items" t-if="!state.collapsed &amp;&amp; state.openCategory === category.code">
                        <button
                            t-foreach="category.items"
                            t-as="item"
                            t-key="item.id"
                            type="button"
                            class="o_psc_sidebar_item"
                            t-att-title="item.name"
                            t-on-click="() => this.openMenu(item)"
                        >
                            <span class="o_psc_sidebar_item_icon">
                                <img t-if="getMenuIcon(item)" t-att-src="getMenuIcon(item)" t-att-alt="item.name"/>
                                <i t-else="" t-att-class="'fa ' + item.fallback_icon"/>
                            </span>
                            <span><t t-esc="item.name"/></span>
                        </button>
                    </div>
                </section>
            </nav>
        </aside>
    </t>
</templates>
