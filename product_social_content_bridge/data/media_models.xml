<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="media_model_openai_gpt_image_2" model="psc.media.model">
        <field name="name">OpenAI GPT Image 2</field>
        <field name="media_type">image</field>
        <field name="provider">openai</field>
        <field name="model_code">gpt-image-2</field>
        <field name="sequence">10</field>
        <field name="notes">当前默认图片生成模型。</field>
    </record>
    <record id="media_model_ffmpeg_default" model="psc.media.model">
        <field name="name">自建 FFmpeg 素材合成</field>
        <field name="media_type">video</field>
        <field name="provider">ffmpeg</field>
        <field name="model_code">ffmpeg-template-v1</field>
        <field name="sequence">10</field>
        <field name="notes">用于后续独立渲染服务合成图片、视频、字幕、配音和音乐。</field>
    </record>
    <record id="media_model_fal_flux_2_pro" model="psc.media.model">
        <field name="name">FLUX.2 Pro（fal.ai）</field>
        <field name="media_type">image</field>
        <field name="provider">fal</field>
        <field name="model_code">fal-ai/flux-2-pro/edit</field>
        <field name="api_key_parameter">ai.fal_key</field>
        <field name="sequence">20</field>
        <field name="notes">低成本图片生成备用模型；使用前配置系统参数 ai.fal_key。</field>
    </record>
    <record id="media_model_fal_kling_25_turbo" model="psc.media.model">
        <field name="name">Kling 2.5 Turbo Pro（fal.ai）</field>
        <field name="media_type">video</field>
        <field name="provider">fal</field>
        <field name="model_code">fal-ai/kling-video/v2.5-turbo/pro/image-to-video</field>
        <field name="api_key_parameter">ai.fal_key</field>
        <field name="sequence">20</field>
        <field name="notes">默认商品图生视频模型；使用前配置系统参数 ai.fal_key。</field>
    </record>
    <record id="media_model_fal_veo_31" model="psc.media.model">
        <field name="name">Google Veo 3.1（fal.ai）</field>
        <field name="media_type">video</field>
        <field name="provider">fal</field>
        <field name="model_code">fal-ai/veo3.1/image-to-video</field>
        <field name="api_key_parameter">ai.fal_key</field>
        <field name="sequence">30</field>
        <field name="notes">高质量商品视频备用模型；成本较高。</field>
    </record>
    <record id="media_model_dashscope_wan_27" model="psc.media.model">
        <field name="name">阿里云万相 Wan 2.7（国内）</field>
        <field name="media_type">video</field>
        <field name="provider">dashscope</field>
        <field name="model_code">wan2.7-i2v</field>
        <field name="api_base_url">https://dashscope.aliyuncs.com/api/v1/services/aigc/video-generation/video-synthesis</field>
        <field name="api_key_parameter">ai.dashscope_key</field>
        <field name="sequence">15</field>
        <field name="notes">国内图生视频模型。使用前在阿里云百炼开通模型，并配置系统参数 ai.dashscope_key。</field>
    </record>
    <record id="media_model_tencent_hunyuan_i2v" model="psc.media.model">
        <field name="name">腾讯混元图生视频（国内）</field>
        <field name="media_type">video</field>
        <field name="provider">tencent</field>
        <field name="model_code">hunyuan-image-to-video-general</field>
        <field name="api_base_url">https://vclm.tencentcloudapi.com</field>
        <field name="api_key_parameter">ai.tencent_secret_key</field>
        <field name="sequence">16</field>
        <field name="notes">使用腾讯云 API 3.0。配置 ai.tencent_secret_id、ai.tencent_secret_key，可选 ai.tencent_region。</field>
    </record>
    <record id="media_model_fal_seedance_25" model="psc.media.model">
        <field name="name">即梦 Seedance 2.5（fal.ai）</field>
        <field name="media_type">video</field>
        <field name="provider">fal</field>
        <field name="model_code">bytedance/seedance-2.5/image-to-video</field>
        <field name="api_key_parameter">ai.fal_key</field>
        <field name="sequence">21</field>
        <field name="notes">支持图生视频和同步音频；共用 ai.fal_key。</field>
    </record>
    <record id="media_model_fal_minimax_hailuo" model="psc.media.model">
        <field name="name">海螺 MiniMax Hailuo 02 Fast（fal.ai）</field>
        <field name="media_type">video</field>
        <field name="provider">fal</field>
        <field name="model_code">fal-ai/minimax/hailuo-02-fast/image-to-video</field>
        <field name="api_key_parameter">ai.fal_key</field>
        <field name="sequence">22</field>
        <field name="notes">低成本快速图生视频；共用 ai.fal_key。</field>
    </record>
    <record id="media_model_vidu_q2_fast" model="psc.media.model">
        <field name="name">Vidu Q2 Pro Fast（直连）</field>
        <field name="media_type">video</field>
        <field name="provider">vidu</field>
        <field name="model_code">viduq2-pro-fast</field>
        <field name="api_base_url">https://api.vidu.com</field>
        <field name="api_key_parameter">ai.vidu_key</field>
        <field name="sequence">23</field>
        <field name="notes">Vidu 官方 API，配置系统参数 ai.vidu_key。</field>
    </record>
    <record id="media_model_baidu_musesteamer_lite" model="psc.media.model">
        <field name="name">百度蒸汽机 2.1 Lite（直连）</field>
        <field name="media_type">video</field>
        <field name="provider">qianfan</field>
        <field name="model_code">musesteamer-2.1-lite-i2v</field>
        <field name="api_base_url">https://qianfan.baidubce.com</field>
        <field name="api_key_parameter">ai.qianfan_key</field>
        <field name="sequence">24</field>
        <field name="notes">百度千帆官方视频 API，配置系统参数 ai.qianfan_key。</field>
    </record>
    <record id="media_model_openai_sora_2_legacy" model="psc.media.model">
        <field name="name">OpenAI Sora 2（即将停用）</field>
        <field name="media_type">video</field>
        <field name="provider">openai</field>
        <field name="model_code">sora-2</field>
        <field name="deprecated" eval="True"/>
        <field name="active" eval="False"/>
        <field name="sequence">90</field>
        <field name="notes">OpenAI 官方已公告该视频 API 将于 2026-09-24 停用，不用于新项目。</field>
    </record>
</odoo>
